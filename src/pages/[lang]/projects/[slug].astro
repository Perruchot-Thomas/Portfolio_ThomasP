---
import Layout from "../../../layouts/Layout.astro";
import { languages } from "../../../data/i18n";
import { projects, getProject } from "../../../data/projects";
import { getLang } from "../../../lib/i18n";

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    projects.map((project) => ({ params: { lang, slug: project.slug } }))
  );
}

const lang = getLang(Astro.params.lang);
const project = getProject(Astro.params.slug ?? "");

if (!project) {
  return Astro.redirect(`/${lang}/projects`);
}
---

<Layout lang={lang} title={`${project.title} - sidus`}>
</Layout>
