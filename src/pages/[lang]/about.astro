---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import AboutPage from "../../components/about/AboutPage.astro";
import { getLang, staticLangPaths, useUi } from "../../lib/i18n";

export const getStaticPaths = staticLangPaths;

const lang = getLang(Astro.params.lang);
const ui = useUi(lang);
---

<Layout lang={lang} title={`${ui.nav.about} - sidus`} description={ui.seo.about} cta={false}>
  <AboutPage lang={lang} />
</Layout>
