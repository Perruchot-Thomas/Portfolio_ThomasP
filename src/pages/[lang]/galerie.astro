---
import Layout from "../../layouts/Layout.astro";
import GalleryPage from "../../components/gallery/GalleryPage.astro";
import { getLang, staticLangPaths, useUi } from "../../lib/i18n";

export const getStaticPaths = staticLangPaths;

const lang = getLang(Astro.params.lang);
const ui = useUi(lang);
---

<Layout lang={lang} title={`${ui.artGallery.name} - sidus`} cta={false}>
  <GalleryPage lang={lang} />
</Layout>
