---
import "../styles/global.css";
import { languages, defaultLang, ui } from "../data/i18n";
import type { Lang } from "../data/i18n";
import Header from "../components/layout/Header.astro";
import MenuOverlay from "../components/layout/MenuOverlay.astro";
import Footer from "../components/layout/Footer.astro";
import Wipe from "../components/layout/Wipe.astro";
import plexRegular from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  theme?: "white" | "blue" | "orange";
  cta?: boolean;
  footer?: boolean;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { lang, title = "sidus - Thomas Perruchot", description = ui[lang].seo.home, theme = "white", footer = true, image = "/og.jpg", type = "website", noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://sidus.tperruchot.fr");
const rest = Astro.url.pathname.replace(/^\/(en|fr)(?=\/|$)/, "").replace(/\/+$/, "");
const pageUrl = (code: Lang) => new URL(`/${code}${rest || "/"}`, site).href;
const canonical = pageUrl(lang);
const ogImage = new URL(image, site).href;
const titleStyle =
  lang === "fr" ? "--title-fit:21.61vw;--title-cap:18.7svh;--about-length:4.748;--proj-length:4.1274" : "--title-fit:18.76vw;--title-cap:65svh;--about-length:3.2085;--proj-length:4.7544";
---

<!doctype html>
<html lang={lang} style={titleStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && languages.map((code) => <link rel="alternate" hreflang={code} href={pageUrl(code)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={pageUrl(defaultLang)} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="sidus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="preload" href={plexRegular} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      (function () {
        if (!sessionStorage.getItem("intro-seen") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.setAttribute("data-intro", "");
        try {
          if (sessionStorage.getItem("wipe") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.setAttribute("data-wipe", "");
        } catch (error) {}
      })();
    </script>
  </head>
  <body id="top" data-theme={theme} class="relative min-h-screen overflow-x-hidden">
    <div class="cursor" data-cursor aria-hidden="true">
      <svg viewBox="-16 -16 32 32" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="butt">
        <path d="M0 -12V12M-10.4 -6L10.4 6M-10.4 6L10.4 -6" />
      </svg>
      <span class="cursor__label" data-cursor-label></span>
    </div>
    <Header lang={lang}>
      <slot name="header-extra" />
    </Header>
    <MenuOverlay lang={lang} />
    <main>
      <slot />
    </main>
    {footer && <Footer lang={lang} />}
    <Wipe />
    <script>
      import { initScroll } from "../lib/scroll";
      import { initScramble } from "../lib/scramble";
      import { initCursor } from "../lib/cursor";
      import { initRoll } from "../lib/roll";
      import { initWipe } from "../lib/wipe";
      initScroll();
      initScramble();
      initCursor();
      initRoll();
      initWipe();
    </script>
  </body>
</html>
