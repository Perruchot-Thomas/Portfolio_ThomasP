---
import "../styles/global.css";
import type { Lang } from "../data/i18n";
import Header from "../components/layout/Header.astro";
import MenuOverlay from "../components/layout/MenuOverlay.astro";
import Footer from "../components/layout/Footer.astro";
import Wipe from "../components/layout/Wipe.astro";
import { useUi } from "../lib/i18n";
import plexRegular from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  theme?: "white" | "blue" | "orange";
  cta?: boolean;
  footer?: boolean;
}

const { lang, title = "sidus - Thomas Perruchot", description = "Portfolio de Thomas Perruchot, graphiste et étudiant MMI.", theme = "white", footer = true } = Astro.props;
const turn = useUi(lang).turn;
const titleStyle =
  lang === "fr" ? "--title-fit:21.61vw;--title-cap:18.7svh;--about-length:4.748;--proj-length:4.1274" : "--title-fit:18.76vw;--title-cap:65svh;--about-length:3.2085;--proj-length:4.7544";
---

<!doctype html>
<html lang={lang} style={titleStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="sidus" />
    <link rel="preload" href={plexRegular} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      (function () {
        if (!sessionStorage.getItem("intro-seen") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.setAttribute("data-intro", "");
        try {
          if (sessionStorage.getItem("turn-skip")) document.documentElement.classList.add("turn-skip");
          if (sessionStorage.getItem("wipe") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.setAttribute("data-wipe", "");
        } catch (error) {}
      })();
    </script>
  </head>
  <body id="top" data-theme={theme} class="relative min-h-screen overflow-x-hidden">
    <div class="cursor" data-cursor aria-hidden="true">
      <svg viewBox="-16 -16 32 32" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="butt">
        <path d="M0 -12V12M-10.4 -6L10.4 6M-10.4 6L10.4 -6" />
      </svg>
      <span class="cursor__label" data-cursor-label></span>
    </div>
    <div class="turn" role="status">
      <svg class="turn__icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="22" y="8" width="20" height="36" rx="3" />
        <path d="M30 39h4" />
        <path d="M12 46c3 6 9 10 16 10" />
        <path d="M24 52l4 4-4 4" />
      </svg>
      <p class="turn__small turn__grey">{turn.label}</p>
      <p class="turn__small">{turn.text}</p>
      <div class="turn__actions">
        <button class="turn__small turn__button" type="button" data-install hidden>[ {turn.install} ↗ ]</button>
        <button class="turn__small turn__button" type="button" data-turn-skip>[ {turn.skip} ]</button>
      </div>
      <p class="turn__small turn__grey turn__ios" data-ios hidden>{turn.ios}</p>
    </div>
    <Header lang={lang}>
      <slot name="header-extra" />
    </Header>
    <MenuOverlay lang={lang} />
    <main>
      <slot />
    </main>
    {footer && <Footer lang={lang} />}
    <Wipe />
    <script>
      import { initScroll } from "../lib/scroll";
      import { initScramble } from "../lib/scramble";
      import { initCursor } from "../lib/cursor";
      import { initRoll } from "../lib/roll";
      import { initWipe } from "../lib/wipe";
      initScroll();
      initScramble();
      initCursor();
      initRoll();
      initWipe();

      const html = document.documentElement;
      const skip = document.querySelector<HTMLButtonElement>("[data-turn-skip]");
      const install = document.querySelector<HTMLButtonElement>("[data-install]");
      const ios = document.querySelector<HTMLElement>("[data-ios]");
      const standalone = window.matchMedia("(display-mode: fullscreen), (display-mode: standalone)").matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;
      let prompt: (Event & { prompt: () => Promise<void> }) | null = null;

      skip?.addEventListener("click", () => {
        html.classList.add("turn-skip");
        try {
          sessionStorage.setItem("turn-skip", "1");
        } catch {}
      });

      if (ios && !standalone && /iPhone|iPod/.test(navigator.userAgent)) ios.hidden = false;

      window.addEventListener("beforeinstallprompt", (event) => {
        event.preventDefault();
        prompt = event as Event & { prompt: () => Promise<void> };
        if (install) install.hidden = false;
      });

      install?.addEventListener("click", async () => {
        if (!prompt) return;
        await prompt.prompt();
        prompt = null;
        install.hidden = true;
      });
    </script>
  </body>
</html>
