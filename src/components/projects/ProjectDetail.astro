---
import { Image } from "astro:assets";
import type { Lang } from "../../data/i18n";
import type { Project } from "../../data/projects";
import { localePath, useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
  project: Project;
  projects: Project[];
}

const { lang, project, projects } = Astro.props;
const ui = useUi(lang);
const copy = ui.work;
const [, byLabel, toolsLabel, contextLabel, visionLabel] = copy.labels;
const pad = (value: number) => String(value).padStart(2, "0");
const index = projects.findIndex((item) => item.slug === project.slug);
const next = projects[(index + 1) % projects.length];
const count = `(${pad(index + 1)}/${pad(projects.length)})`;
const name = project.name;
let figure = 0;
const frames = project.frames.map((frame) => (frame.kind === "image" ? { ...frame, number: pad(++figure) } : { ...frame, number: "" }));
---

<article class="work" data-work>
  <aside class="work__side">
    <div class="work__head">
      <p class="work__small work__grey">{count}</p>
      <h1 class="work__title" data-title>{name}</h1>
    </div>

    <div class="work__group">
      <p class="work__small work__grey">{visionLabel}</p>
      <p class="work__small">{project.vision[lang]}</p>
    </div>

    <div class="work__meta">
      <div class="work__group">
        <p class="work__small work__grey">{contextLabel}</p>
        <ul class="work__small work__list">
          {project.context[lang].split(" / ").map((item) => <li>× {item}</li>)}
        </ul>
      </div>
      <div class="work__group">
        <p class="work__small work__grey">{toolsLabel}</p>
        <p class="work__small">× {project.tools}</p>
      </div>
      <div class="work__group">
        <p class="work__small work__grey">{byLabel}</p>
        <p class="work__small">× sidus</p>
      </div>
      <div class="work__group">
        <p class="work__small work__grey">{copy.year}</p>
        <p class="work__small">× {project.year}</p>
      </div>
    </div>


    <div class="work__foot">
      <a class="work__small" href={localePath(lang, "")}>[ ← {copy.back} ]</a>
      {
        project.stream && (
          <a class="work__small" href={project.stream} target="_blank" rel="noopener noreferrer">
            [ {copy.stream} ↗ ]
          </a>
        )
      }
    </div>
  </aside>

  <div class="work__view" data-view>
    <div class="work__track" data-track>
      {
        frames.map((frame) =>
          frame.kind === "image" ? (
            <figure class="work__frame" data-frame>
              <Image src={frame.image} alt={name} width={1600} format="webp" quality={82} loading={frame.number === "01" ? "eager" : "lazy"} draggable="false" />
              <figcaption class="work__small work__grey">({copy.figure} {frame.number})</figcaption>
            </figure>
          ) : (
            <div class="work__note">
              <p class="work__small work__grey">{frame.label[lang]}</p>
              <p class="work__small work__text">{frame.text[lang]}</p>
            </div>
          )
        )
      }

      <a class="work__next" href={localePath(lang, `/projects/${next.slug}`)}>
        <span class="work__small work__grey">({copy.next})</span>
        <span class="work__next-name">{next.name}</span>
        <span class="work__small">[ → ]</span>
      </a>
    </div>

    <div class="work__rail" aria-hidden="true">
      <span class="work__rail-fill" data-rail></span>
    </div>
  </div>
</article>

<style>
  .work {
    display: grid;
    grid-template-columns: minmax(0, 27vw) minmax(0, 1fr);
    height: 100svh;
    overflow: hidden;
    color: var(--color-black);
    background: var(--color-white);
  }

  .work__small {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    font-weight: var(--font-weight-regular);
  }

  .work__grey {
    color: var(--color-grey);
  }

  .work a {
    color: inherit;
  }

  .work__side {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4svh;
    padding: 11svh 2vw 4svh var(--gutter);
    background: var(--color-white);
  }

  .work__head {
    display: flex;
    flex-direction: column;
    gap: 1.2svh;
  }

  .work__title {
    margin: 0;
    font-size: var(--text-mid);
    line-height: 1;
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .work__group {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .work__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.4svh 1.6vw;
  }




  .work__foot {
    display: flex;
    gap: 1.6em;
  }

  .work__view {
    position: relative;
    overflow: hidden;
  }

  .work__track {
    display: flex;
    align-items: center;
    gap: 3vw;
    width: max-content;
    height: 100%;
    padding: 11svh 6vw 10svh 3vw;
    will-change: transform;
  }

  .work__frame {
    position: relative;
    flex-shrink: 0;
    height: 64svh;
    margin: 0;
  }



  .work__frame img {
    display: block;
    width: auto;
    height: 100%;
    user-select: none;
  }



  .work__frame figcaption {
    position: absolute;
    top: calc(100% + 0.8em);
    left: 0;
    white-space: nowrap;
  }

  .work__note {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    gap: 0.8em;
    width: 19em;
  }



  .work__text {
    white-space: pre-line;
  }

  .work__next {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
    gap: 2svh;
    min-width: 52vw;
    height: 100%;
    padding: 0 4vw 0 6vw;
    border-left: 1px solid var(--color-grey-light);
    text-decoration: none;
  }

  .work__next-name {
    font-size: var(--text-order);
    line-height: var(--text-order--line-height);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transition: color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work__next:hover .work__next-name {
    color: var(--color-grey);
  }

  .work__rail {
    position: absolute;
    right: var(--gutter);
    bottom: 4svh;
    left: 3vw;
    height: 1px;
    background: var(--color-grey-light);
  }

  .work__rail-fill {
    position: absolute;
    inset: 0;
    background: var(--color-black);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (max-width: 767px) {
    .work {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }

    .work__side {
      gap: 2svh;
      padding: 10svh var(--gutter) 2svh;
    }

    .work__meta {
      display: none;
    }

    .work__track {
      gap: 6vw;
      padding: 2svh 10vw 8svh var(--gutter);
    }

    .work__frame {
      height: 44svh;
    }

    .work__note {
      width: 72vw;
    }

    .work__next {
      min-width: 86vw;
    }

    .work__rail {
      left: var(--gutter);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work__view {
      overflow-x: auto;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const work = document.querySelector<HTMLElement>("[data-work]");
  const view = work?.querySelector<HTMLElement>("[data-view]");
  const track = work?.querySelector<HTMLElement>("[data-track]");
  const rail = work?.querySelector<HTMLElement>("[data-rail]");

  if (work && view && track && rail && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const distance = () => Math.max(0, track.scrollWidth - view.clientWidth);

    gsap.to(track, {
      x: () => -distance(),
      ease: "none",
      scrollTrigger: {
        trigger: work,
        start: "top top",
        end: () => `+=${distance()}`,
        pin: true,
        scrub: 0.8,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          gsap.set(rail, { scaleX: self.progress });
        }
      }
    });

    window.addEventListener("load", () => ScrollTrigger.refresh());
  }
</script>
