---
import type { Lang } from "../../data/i18n";
import selfie from "../../assets/photos/IMG_9852.jpeg";
import mirror from "../../assets/photos/IMG_9852 2.jpeg";
import blur from "../../assets/photos/imagemoi copie.avif";
import photo1 from "../../assets/photos/photo-1.jpg";
import photo2 from "../../assets/photos/photo-2.jpg";
import photo3 from "../../assets/photos/photo-3.jpg";
import photo5 from "../../assets/photos/photo-5.jpg";
import photo6 from "../../assets/photos/photo-6.jpg";
import photo7 from "../../assets/photos/photo-7.jpg";
import grain from "../../assets/photos/photo header.avif";
import drawing from "../../assets/about/drawing.jpg";
import penTablet from "../../assets/about/pen-tablet.jpg";
import tshirt from "../../assets/about/tshirt.jpg";
import { socials } from "../../data/site";
import { localePath, useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const copy = ui.aboutPage;
const sentence = (value: string) => {
  const lower = value.toLowerCase();
  return (lower.charAt(0).toUpperCase() + lower.slice(1)).replace(/\bmmi\b/gi, "MMI");
};
const steps = ui.about.skills.map((skill) => ({ label: sentence(skill.label), year: skill.year }));
const email = socials.find((social) => social.id === "email");

const photos = [selfie, photo1, drawing, blur, photo2, tshirt, mirror, photo5, penTablet, photo3, photo6, grain, photo7];
const offsets = [
  [-4, -6, -5],
  [-30, -22, 4],
  [28, 18, -3],
  [34, -24, 7],
  [-36, 20, -8],
  [10, -30, 3],
  [-16, 26, -4],
  [22, -8, 6],
  [-26, -4, -7],
  [38, 4, 2],
  [6, 24, -3],
  [-38, -28, 8],
  [16, -26, -6],
  [-10, 10, 5],
  [30, 30, -1],
  [0, -2, 4]
];
const items = photos.map((image, index) => {
  const [x, y, turn] = offsets[index % offsets.length];
  return { image, x, y, turn };
});
---

<section class="me" data-me>
  <div class="me__area me__area--name">
    <p class="me__small me__grey">{copy.sections[0]}</p>
    <h1 class="me__name">{ui.cta.first}<br />{ui.cta.last}</h1>
  </div>

  <p class="me__area me__area--identity me__small">{ui.showcase.identity[1]}</p>

  <div class="me__area me__area--path">
    <p class="me__small me__grey">{copy.path}</p>
    <ul class="me__small me__list">
      {steps.map((step) => <li><span class="me__grey">{step.year}</span> {step.label}</li>)}
    </ul>
  </div>

  <div class="me__area me__area--jobs">
    <p class="me__small me__grey">{ui.showcase.jobs[0]}</p>
    <p class="me__small">{ui.showcase.jobs[1]}</p>
  </div>

  <div class="me__area me__area--tools">
    <p class="me__small me__grey">{copy.tools}</p>
    <p class="me__small">{ui.intro.tools.join(", ")}</p>
  </div>

  <p class="me__area me__area--hint me__small me__grey">[ {ui.hero.scroll} ↓ ]</p>

  <div class="me__area me__area--status">
    <p class="me__small me__grey">{ui.showcase.status[0]}</p>
    <p class="me__small">{ui.showcase.status[1]}</p>
    <a class="me__small" href={localePath(lang, "/contact")}>[ {ui.footer.internshipLink} ↗ ]</a>
    {email && <a class="me__small me__grey" href={email.href}>{email.label}</a>}
  </div>

  <div class="me__pile" data-pile aria-hidden="true">
    {
      items.map((item) => (
        <figure class="me__photo" data-photo data-x={item.x} data-y={item.y} data-turn={item.turn}>
          <img src={item.image.src} width={item.image.width} height={item.image.height} alt="" loading="lazy" draggable="false" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .me {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "name . identity"
      "path . jobs"
      "tools hint status";
    gap: 4svh 2vw;
    height: 100svh;
    padding: 11svh var(--gutter) 5svh;
    overflow: hidden;
    color: var(--color-black);
    background: var(--color-white);
  }

  .me__small {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    font-weight: var(--font-weight-regular);
  }

  .me__grey {
    color: var(--color-grey);
  }

  .me a {
    color: inherit;
  }

  .me__area {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .me__area--name {
    grid-area: name;
  }

  .me__area--identity {
    grid-area: identity;
    justify-self: end;
    max-width: 22em;
    text-align: right;
  }

  .me__area--path {
    grid-area: path;
    align-self: center;
  }

  .me__area--jobs {
    grid-area: jobs;
    align-self: center;
    align-items: flex-end;
    text-align: right;
  }

  .me__area--tools {
    grid-area: tools;
    align-self: end;
  }

  .me__area--hint {
    grid-area: hint;
    align-self: end;
    justify-self: center;
  }

  .me__area--status {
    grid-area: status;
    align-self: end;
    align-items: flex-end;
    text-align: right;
  }

  .me__name {
    margin: 0;
    font-size: var(--text-order);
    line-height: var(--text-order--line-height);
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .me__list {
    padding: 0;
    list-style: none;
  }

  .me__pile {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .me__photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 16vw;
    margin: 0;
    will-change: transform;
  }

  .me__photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 767px) {
    .me {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "name name"
        "identity identity"
        "path jobs"
        "tools status";
      grid-template-rows: auto auto 1fr auto;
      gap: 3svh 4vw;
    }

    .me__area--identity {
      justify-self: start;
      text-align: left;
    }

    .me__area--hint {
      display: none;
    }

    .me__photo {
      width: 36vw;
    }  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const me = document.querySelector<HTMLElement>("[data-me]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (me) {
    const photos = Array.from(me.querySelectorAll<HTMLElement>("[data-photo]"));
    const place = (photo: HTMLElement) => ({
      x: (Number(photo.dataset.x) / 100) * window.innerWidth,
      y: (Number(photo.dataset.y) / 100) * window.innerHeight,
      turn: Number(photo.dataset.turn)
    });

    photos.forEach((photo, index) => {
      photo.style.zIndex = String(index + 1);
      gsap.set(photo, { xPercent: -50, yPercent: -50 });
    });

    if (reduced) {
      photos.forEach((photo) => {
        const spot = place(photo);
        gsap.set(photo, { x: spot.x, y: spot.y, rotation: spot.turn });
      });
    } else {
      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: me,
          start: "top top",
          end: () => `+=${window.innerHeight * photos.length * 0.32}`,
          pin: true,
          scrub: 0.8,
          invalidateOnRefresh: true
        }
      });

      photos.forEach((photo, index) => {
        timeline.fromTo(
          photo,
          {
            x: () => place(photo).x * 0.4,
            y: () => window.innerHeight * 0.95,
            rotation: () => place(photo).turn * 3
          },
          {
            x: () => place(photo).x,
            y: () => place(photo).y,
            rotation: () => place(photo).turn,
            duration: 1,
            ease: "power3.out"
          },
          index * 0.6
        );
      });
    }
  }
</script>
