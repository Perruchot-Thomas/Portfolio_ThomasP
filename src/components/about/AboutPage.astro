---
import type { Lang } from "../../data/i18n";
import unionRaw from "../../assets/svg/union.svg?raw";
import selfie from "../../assets/photos/IMG_9852.jpeg";
import drawing from "../../assets/about/drawing.jpg";
import penTablet from "../../assets/about/pen-tablet.jpg";
import firstCollab from "../../assets/about/first-collab.jpg";
import tshirt from "../../assets/about/tshirt.jpg";
import photoshop from "../../assets/about/photoshop.png";
import mmi from "../../assets/about/mmi.png";
import texture from "../../assets/textures/texture-2.jpg";
import desurbanisation from "../../assets/projets/07-desurbanisation.jpg";
import acab from "../../assets/projets/02-acab.jpg";
import flowers from "../../assets/projets/09-flowers-in-mind.jpg";
import redEyes from "../../assets/projets/12-red-eyes.jpg";
import { useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const copy = ui.aboutPage;
const shapePath = unionRaw.match(/ d="([^"]+)"/)?.[1] ?? "";

const pictures = [
  { image: drawing, size: "s" },
  { image: penTablet, size: "s" },
  { image: desurbanisation, size: "m" },
  { image: mmi, size: "s" },
  { image: selfie, size: "l" },
  { image: firstCollab, size: "s" },
  { image: tshirt, size: "s" },
  { image: acab, size: "m" },
  { image: flowers, size: "m" },
  { image: photoshop, size: "s" },
  { image: texture, size: "s" },
  { image: redEyes, size: "m" }
];

const [w1, w2, w3, w4, w5] = copy.words;
const layout: [number | "end", string | number][][] = [
  [[1, w1], [5, 0], [6, 2], [8, ")"], [10, "("], [11, 3]],
  [[1, w2], [5, 1], [7, 4], [9, ")"], [11, "("], [12, 5]],
  [[1, 6], [2, ")"], [3, "("], [4, 7], ["end", w3]],
  [[1, w4], [6, 8], [7, ")"], [8, "("], [10, 9]],
  [[1, 10], [2, "("], [4, 11], [5, ")"], ["end", w5]]
];

const lines = layout.map((tokens) =>
  tokens.map(([column, token]) => {
    const place = column === "end" ? "grid-column:1 / -1;justify-self:end" : `grid-column:${column}`;
    if (typeof token === "number") return { kind: "picture" as const, place, ...pictures[token] };
    return { kind: "word" as const, place, text: token };
  })
);

const path = ui.about.skills.map((skill, index) => ({
  ...skill,
  number: String(index + 1).padStart(2, "0"),
  letters: Array.from(skill.label)
}));
---

<section class="order" data-order>
  <p class="order__small order__presents">
    {copy.presents.map((line) => <span>{line}</span>)}
  </p>

  <h1 class="order__title" aria-label={`${copy.title} — ${copy.words.join(" ")}`}>
    {
      lines.map((tokens) => (
        <span class="order__line" aria-hidden="true">
          {tokens.map((token) =>
            token.kind === "word" ? (
              <span class="order__word" style={token.place} data-token>{token.text}</span>
            ) : (
              <span class:list={["order__pic", `order__pic--${token.size}`]} style={token.place} data-token>
                <img src={token.image.src} width={token.image.width} height={token.image.height} alt="" draggable="false" />
              </span>
            )
          )}
        </span>
      ))
    }
  </h1>

  <div class="order__foot">
    <p class="order__small">
      <span class="order__grey">{copy.tools}</span> {ui.intro.tools.join(", ")}
    </p>
    <p class="order__small order__role">
      {copy.role.map((line) => <span>{line}</span>)}
    </p>
  </div>
</section>

<section class="path" id="path" data-path data-src={selfie.src}>
  <svg class="path__shape" viewBox="0 0 2682.8 1003.22" preserveAspectRatio="none" aria-hidden="true">
    <path d={shapePath} />
  </svg>

  <div class="path__inner">
    <div class="path__head">
      <p class="order__small">{copy.path}</p>
      <p class="order__small">{copy.quote}</p>
    </div>

    <p class="path__giant" aria-hidden="true">{copy.range}</p>

    <ol class="path__rows">
      {
        path.map((step) => (
          <li class="path__row">
            <span class="order__small path__num">{step.number}</span>
            <span class="path__label" aria-label={step.label}>
              {step.letters.map((letter) => (
                <span class="path__letter" data-letter aria-hidden="true">
                  {letter === " " ? "\u00a0" : letter}
                </span>
              ))}
            </span>
            <span class="order__small path__year">{step.year}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .order__small {
    display: flex;
    flex-direction: column;
    margin: 0;
    color: var(--color-black);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    font-weight: var(--font-weight-regular);
  }

  .order__grey {
    display: inline;
    color: var(--color-grey);
  }

  .order {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4svh;
    min-height: 100svh;
    padding: 11svh var(--gutter) 5svh;
    overflow: hidden;
    color: var(--color-black);
  }

  .order__title {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: var(--text-order);
    line-height: var(--text-order--line-height);
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .order__line {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
  }

  .order__word,
  .order__pic {
    grid-row: 1;
    justify-self: start;
  }

  .order__word {
    display: block;
  }

  .order__pic {
    position: relative;
    z-index: 1;
    display: block;
    flex: none;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .order__pic:hover {
    z-index: 2;
    transform: scale(1.6);
  }

  .order__pic img {
    display: block;
    width: auto;
    height: 100%;
  }

  .order__pic--s {
    height: 0.52em;
  }

  .order__pic--m {
    height: 1em;
  }

  .order__pic--l {
    height: 1.9em;
    margin-block: -0.5em;
  }

  .order__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4vw;
  }

  .order__role {
    text-align: right;
  }

  .path {
    position: relative;
    padding: 30vw var(--gutter) 34vw;
    color: var(--color-white);
  }

  .path .order__small {
    color: inherit;
  }

  .path__shape {
    position: absolute;
    top: 0;
    left: 50%;
    width: 209.6vw;
    height: 100%;
    margin-left: -104.8vw;
    fill: var(--color-black);
    pointer-events: none;
  }

  .path__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5svh;
  }

  .path__head {
    display: flex;
    justify-content: space-between;
  }

  .path__giant {
    margin: 0;
    font-size: var(--text-giant);
    line-height: var(--text-giant--line-height);
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .path__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-grey);
  }

  .path__row {
    display: grid;
    grid-template-columns: 6vw 1fr auto;
    align-items: center;
    gap: 2vw;
    padding: 1.6svh 0;
    border-bottom: 1px solid var(--color-grey);
  }

  .path .path__num {
    color: var(--color-grey);
  }

  .path__label {
    display: flex;
    font-size: var(--text-mid);
    line-height: 1;
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .path__letter {
    position: relative;
    display: inline-block;
  }

  .path__letter.is-image {
    color: transparent;
  }

  .path__letter :global(i) {
    position: absolute;
    top: 0.14em;
    left: 0;
    display: none;
    width: 100%;
    height: 0.711em;
    background-size: var(--photo-size) auto;
    background-position: var(--photo-x) 30%;
    image-rendering: pixelated;
  }

  .path__letter.is-image :global(i) {
    display: block;
  }

  @media (max-width: 767px) {
    .order__title {
      font-size: calc(var(--text-order) * 1.5);
    }

    .order__line {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 0.2em;
    }

    .order__foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .order__role {
      text-align: left;
    }

    .path__row {
      grid-template-columns: auto 1fr auto;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const order = document.querySelector<HTMLElement>("[data-order]");

  if (order && !reduced) {
    const tokens = Array.from(order.querySelectorAll<HTMLElement>("[data-token]"));
    gsap.from(tokens, {
      yPercent: 40,
      autoAlpha: 0,
      duration: 0.9,
      ease: "power3.out",
      stagger: { each: 0.035, from: "random" },
      delay: 0.15
    });
  }

  const path = document.querySelector<HTMLElement>("[data-path]");

  if (path) {
    const source = path.dataset.src ?? "";
    const letters = Array.from(path.querySelectorAll<HTMLElement>("[data-letter]"));

    letters.forEach((letter) => {
      const tile = document.createElement("i");
      tile.style.backgroundImage = `url("${source}")`;
      letter.append(tile);
      let timer = 0;

      const show = () => {
        window.clearTimeout(timer);
        const width = letter.closest(".path__label")?.getBoundingClientRect().width ?? 600;
        tile.style.setProperty("--photo-size", `${width}px`);
        tile.style.setProperty("--photo-x", `${-letter.offsetLeft}px`);
        letter.classList.add("is-image");
      };

      letter.addEventListener("pointerenter", show);
      letter.addEventListener("pointerleave", () => {
        timer = window.setTimeout(() => letter.classList.remove("is-image"), 600);
      });
    });

    if (!reduced && letters.length) {
      let visible = false;
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
      }).observe(path);
      window.setInterval(() => {
        if (!visible) return;
        const letter = letters[Math.floor(Math.random() * letters.length)];
        letter.dispatchEvent(new PointerEvent("pointerenter"));
        window.setTimeout(() => letter.dispatchEvent(new PointerEvent("pointerleave")), 500 + Math.random() * 700);
      }, 260);
    }
  }
</script>
