---
import type { Lang } from "../../data/i18n";
import { navItems, socials } from "../../data/site";
import { localePath, useUi } from "../../lib/i18n";
import sidusRaw from "../../assets/@sidus.svg?raw";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const pathname = Astro.url.pathname.replace(/\/$/, "");
const isActive = (path: string) => pathname === localePath(lang, path);
const sidusPath = sidusRaw.match(/<path d="([^"]+)" fill="#000"/)?.[1] ?? "";
const [, sidusW, sidusH] = sidusRaw.match(/width="([\d.]+)" height="([\d.]+)"/) ?? [];
const sidusBox = { width: Number(sidusW), height: Number(sidusH) };
const sidusRatio = sidusBox.width / sidusBox.height;
const maskSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${sidusBox.width} ${sidusBox.height}"><path d="${sidusPath}"/></svg>`;
const maskUrl = `url("data:image/svg+xml,${encodeURIComponent(maskSvg)}")`;
const entries = navItems.map((item, index) => ({ ...item, index }));
const about = [ui.showcase.identity, ui.showcase.jobs, ui.showcase.status];
---

<aside id="menu" class="menu" data-open="false" data-dragging="false" aria-label={ui.menuLabel}>
  <div class="menu__clip">
    <div class="menu__sheet" inert>
      <div class="menu__giant" aria-hidden="true" style={`--mask:${maskUrl};--ratio:${sidusRatio}`}>
        <div class="menu__giant-glass"></div>
        <svg viewBox={`0 0 ${sidusBox.width} ${sidusBox.height}`}>
          <path d={sidusPath} fill="rgb(255 255 255 / 0.18)"></path>
        </svg>
      </div>
      <div class="menu__zoom" aria-hidden="true"><span></span></div>
      <div class="menu__story" data-story aria-hidden="true">
        <p class="menu__story-small menu__story-label" data-split>{about[0][0]}</p>
        <p class="menu__story-small menu__story-line" data-split>{about[0][1]}</p>
        <p class="menu__story-big" data-split>{about[1][1]}</p>
        <p class="menu__story-small menu__story-label" data-split>{about[2][0]}</p>
        <p class="menu__story-small menu__story-line" data-split>{about[2][1]}</p>
      </div>
      <dl class="menu__about" data-about>
        {
          about.map(([label, text]) => (
            <div class="menu__about-row">
              <dt data-split>{label}</dt>
              <dd data-split>{text}</dd>
            </div>
          ))
        }
      </dl>
      <nav class="menu__nav menu__nav--top" aria-label={ui.menuLabel}>
        <ul>
          {
            entries.map((item) => (
              <li>
                <a href={localePath(lang, item.path)} aria-current={isActive(item.path) ? "page" : undefined}>
                  <sup>{String(item.index + 1).padStart(2, "0")}</sup>
                  <span class="menu__label">{ui.nav[item.key]}</span>
                </a>
              </li>
            ))
          }
          <li>
            <button class="menu__info" type="button" data-about-toggle aria-expanded="false">[ {about[0][0]} ]</button>
          </li>
        </ul>
      </nav>
      <div class="menu__bottom">
        <ul class="menu__socials">
          {
            socials.map((social) => (
              <li>
                <a href={social.href} target={social.id === "email" ? undefined : "_blank"} rel="noopener noreferrer" data-zoom-label={social.id === "email" ? "email" : social.label}>
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</aside>
  <button
    type="button"
    class="menu__handle"
    data-menu-handle
    role="slider"
    aria-label={ui.menuLabel}
    aria-orientation="vertical"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span class="menu__pull">Pull me</span>
  </button>

<style>
  :global(:root) {
    --h: 0px;
  }

  .menu {
    --sheet-h: min(100vh, max(70vh, 24rem));
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    --tab-h: 46px;
    height: calc(var(--h) + var(--tab-h));
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-grey-light) 58%, transparent), color-mix(in srgb, var(--color-grey-light) 44%, transparent) 45%, color-mix(in srgb, var(--color-grey-light) 58%, transparent));
    -webkit-backdrop-filter: blur(20px) saturate(1.8) brightness(1.08);
    backdrop-filter: blur(20px) saturate(1.8) brightness(1.08);
    transition: height 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow:
      inset 0 -1px 0 rgb(255 255 255 / 0.7),
      inset 1px 0 0 rgb(255 255 255 / 0.5),
      inset -1px 0 0 rgb(255 255 255 / 0.5),
      inset 0 -14px 28px -14px rgb(255 255 255 / 0.6),
      inset 0 0 50px rgb(255 255 255 / 0.12);
    pointer-events: none;
  }

  .menu[data-dragging="true"] {
    transition: none;
  }

  .menu__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .menu__clip::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 120% at 0% 0%, rgb(255 255 255 / 0.5), transparent 60%),
      radial-gradient(60% 100% at 100% 100%, rgb(255 255 255 / 0.3), transparent 65%),
      linear-gradient(105deg, transparent 28%, rgb(255 255 255 / 0.28) 40%, transparent 54%, rgb(255 255 255 / 0.12) 70%, transparent 82%);
    background-size: 100% 100%, 100% 100%, 260% 100%;
    background-position: 0 0, 0 0, 0% 0;
    animation: menu-sheen 9s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes menu-sheen {
    to {
      background-position: 0 0, 0 0, 100% 0;
    }
  }

  .menu__sheet {
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--sheet-h);
    transform: translateY(min(0px, calc(var(--h) - var(--sheet-h))));
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu[data-dragging="true"] .menu__sheet {
    transition: none;
  }

  .menu__giant {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(92vw, calc((var(--sheet-h) - 12rem) * var(--ratio)));
    aspect-ratio: var(--ratio);
    transform: translate(-50%, -50%);
    user-select: none;
    transition: opacity 0.35s;
  }

  .menu[data-zoom="true"] .menu__giant {
    opacity: 0;
  }

  .menu__zoom {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: scale(0.08);
    transform-origin: var(--ox, 50%) var(--oy, 50%);
    transition: opacity 0.3s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .menu__zoom span {
    font-weight: var(--font-weight-bold);
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-black);
  }

  .menu[data-zoom="true"] .menu__zoom {
    opacity: 1;
    transform: none;
  }

  .menu__giant-glass {
    position: absolute;
    inset: 0;
    background: rgb(255 255 255 / 0.42);
    -webkit-backdrop-filter: blur(38px) saturate(2.2) brightness(1.25);
    backdrop-filter: blur(38px) saturate(2.2) brightness(1.25);
    -webkit-mask: var(--mask) center / 100% 100% no-repeat;
    mask: var(--mask) center / 100% 100% no-repeat;
  }

  .menu__giant svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  :global(html[data-intro]),
  :global(html[data-intro] body) {
    overflow: hidden;
  }

  :global(html[data-intro]) .menu {
    height: 100svh;
    transition: none;
  }

  :global(html[data-intro]) .menu__sheet {
    height: 100svh;
    transform: none;
    transition: none;
  }

  .menu.is-intro {
    transition: none;
  }

  .menu.is-intro .menu__sheet {
    height: 100svh;
    transform: translateY(min(0px, calc(var(--h) - 100svh)));
    transition: none;
  }

  :global(html[data-intro]) .menu__nav,
  :global(html[data-intro]) .menu__bottom,
  :global(html[data-intro]) .menu__handle,
  .menu.is-intro .menu__nav,
  .menu.is-intro .menu__bottom,
  .menu.is-intro ~ .menu__handle {
    opacity: 0;
    pointer-events: none;
  }

  .menu__story {
    position: absolute;
    top: 50%;
    left: 2rem;
    right: 2rem;
    z-index: 3;
    display: grid;
    grid-template-columns: 9em minmax(0, 34em);
    justify-content: center;
    gap: 1.2em 2vw;
    color: var(--color-black);
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-50%);
  }

  :global(html[data-intro]) .menu__story,
  .menu.is-intro .menu__story {
    visibility: visible;
  }

  .menu__story-small {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    font-weight: var(--font-weight-regular);
  }

  .menu__story-label {
    color: var(--color-grey);
  }

  .menu__story-big {
    grid-column: 1 / -1;
    margin: 0.4em 0;
    font-size: var(--text-mid);
    line-height: 1;
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.01em;
    text-align: center;
    text-transform: uppercase;
  }

  .menu__info {
    padding: 0.15em 0.55em;
    border: 0;
    background: var(--color-white);
    color: var(--color-black);
    font: inherit;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    cursor: pointer;
    transition:
      background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu__info:hover,
  .menu__info[aria-expanded="true"] {
    background: var(--color-black);
    color: var(--color-white);
  }

  .menu__about {
    position: absolute;
    top: calc(4.5rem + 3em);
    bottom: calc(2.5rem + 3em);
    right: 2rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9em;
    width: min(26em, calc(100% - 4rem));
    margin: 0;
    color: var(--color-black);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    visibility: hidden;
    pointer-events: none;
  }

  .menu__about.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .menu__about-row {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 0.8em;
  }

  .menu__about-row dt {
    color: var(--color-grey);
  }

  .menu__about-row dd {
    margin: 0;
  }

  :global(.split-word) {
    display: inline-block;
    white-space: nowrap;
  }

  :global(.split-char) {
    display: inline-block;
    will-change: transform, opacity, filter;
  }

  .menu__nav--top {
    position: absolute;
    top: 4.5rem;
    inset-inline: 2rem;
  }

  .menu__bottom {
    position: absolute;
    inset-inline: 2rem;
    bottom: 2.5rem;
  }

  .menu__nav ul {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .menu__nav a {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: var(--text-small);
    font-weight: var(--font-weight-regular);
    line-height: var(--text-small--line-height);
    color: var(--color-black);
    white-space: nowrap;
    transition: opacity 0.25s;
  }

  .menu__nav a sup {
    margin-top: -0.2em;
    font-size: 0.6em;
    opacity: 0.55;
  }

  .menu__nav ul:hover a:not(:hover) {
    opacity: 0.35;
  }

  .menu__nav a[aria-current="page"] .menu__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .menu__socials {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    font-size: var(--text-small);
    font-weight: var(--font-weight-regular);
    line-height: var(--text-small--line-height);
  }

  .menu__socials a:hover {
    text-decoration: underline;
  }

  .menu__handle {
    position: fixed;
    top: var(--h);
    left: 50%;
    z-index: 65;
    width: 176px;
    height: 46px;
    padding: 0 0 2px;
    border: 0;
    color: var(--color-black);
    font: inherit;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    background: none;
    transform: translateX(-50%);
    cursor: grab;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      top 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s;
  }

  .menu[data-dragging="true"] ~ .menu__handle {
    cursor: grabbing;
    transition: none;
  }

  .menu__handle:hover .menu__pull,
  .menu__handle:focus-visible .menu__pull {
    opacity: 0.55;
  }

  .menu__handle:focus-visible {
    outline: none;
  }

  .menu__pull {
    display: block;
    transition: opacity 0.25s ease;
    font-weight: var(--font-weight-regular);
    white-space: nowrap;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .menu {
      --sheet-h: min(100svh, max(78svh, 30rem));
    }

    .menu__handle {
      width: 132px;
    }

    .menu__nav--top {
      top: 4.25rem;
      inset-inline: var(--gutter);
    }

    .menu__nav ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1.5rem;
    }

    .menu__nav a {
      align-items: center;
      min-height: 44px;
    }

    .menu__nav li {
      display: flex;
      align-items: center;
    }

    .menu__nav li:nth-child(even) {
      justify-content: flex-end;
    }

    .menu__info {
      min-height: 32px;
    }

    .menu__bottom {
      inset-inline: var(--gutter);
      bottom: 2rem;
    }

    .menu__socials {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1.5rem;
    }

    .menu__socials li {
      display: flex;
    }

    .menu__socials li:nth-child(even) {
      justify-content: flex-end;
    }

    .menu__socials a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    .menu__giant {
      top: 58%;
      width: min(calc(100vw - var(--gutter) * 2), calc((var(--sheet-h) - 22rem) * var(--ratio)));
    }

    .menu__about {
      top: auto;
      right: var(--gutter);
      bottom: calc(2rem + 88px + 1rem);
      left: var(--gutter);
      width: auto;
      justify-content: flex-end;
    }

    .menu:has(.menu__about.is-open) .menu__giant {
      opacity: 0;
    }

    .menu__story {
      left: var(--gutter);
      right: var(--gutter);
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6em;
    }

    .menu__story-big {
      margin: 0.8em 0;
      text-align: left;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  const menu = document.getElementById("menu");
  const sheet = menu?.querySelector<HTMLElement>(".menu__sheet");
  const handle = document.querySelector<HTMLElement>("[data-menu-handle]");

  if (menu && sheet && handle) {
    const maxHeight = () => Math.min(window.innerHeight, window.innerWidth < 768 ? Math.max(window.innerHeight * 0.78, 480) : Math.max(window.innerHeight * 0.7, 384));
    const openHeight = () => maxHeight();
    let height = 0;
    let dragStart = 0;
    let heightStart = 0;
    let moved = false;

    const shape = (value: number) => {
      const width = window.innerWidth;
      const center = width / 2;
      const half = width < 768 ? 92 : 118;
      const curve = 30;
      const tab = 46;
      const h = Math.max(0, value);
      const right = center + half;
      const left = center - half;
      const shoulder = 22;
      const round = 22;
      const inner = right - curve;
      const outer = left + curve;
      menu.style.clipPath = `path("M0 0 H${width} V${h} H${right} C${right - curve * 0.45} ${h} ${inner} ${h + shoulder * 0.35} ${inner} ${h + shoulder} V${h + tab - round} C${inner} ${h + tab - round * 0.45} ${inner - round * 0.45} ${h + tab} ${inner - round} ${h + tab} H${outer + round} C${outer + round * 0.45} ${h + tab} ${outer} ${h + tab - round * 0.45} ${outer} ${h + tab - round} V${h + shoulder} C${outer} ${h + shoulder * 0.35} ${left + curve * 0.45} ${h} ${left} ${h} H0 Z")`;
    };

    let following = 0;
    const follow = () => {
      cancelAnimationFrame(following);
      const until = performance.now() + 1100;
      const step = () => {
        shape(menu.getBoundingClientRect().height - 46);
        if (performance.now() < until) following = requestAnimationFrame(step);
      };
      step();
    };

    const render = (next: number) => {
      if (next <= 8) menu.dataset.zoom = "false";
      height = Math.max(0, Math.min(maxHeight(), next));
      if (menu.dataset.dragging === "true") shape(height);
      else follow();
      const open = height > 8;
      document.documentElement.style.setProperty("--h", `${height}px`);
      menu.dataset.open = String(open);
      menu.setAttribute("aria-expanded", String(open));
      handle.setAttribute("aria-valuenow", String(Math.round((height / maxHeight()) * 100)));
      sheet.toggleAttribute("inert", !open);
    };

    const toggle = () => render(height > 8 ? 0 : openHeight());

    handle.addEventListener("pointerdown", (event) => {
      handle.setPointerCapture(event.pointerId);
      menu.dataset.dragging = "true";
      dragStart = event.clientY;
      heightStart = height;
      moved = false;
    });

    handle.addEventListener("pointermove", (event) => {
      if (menu.dataset.dragging !== "true") return;
      const delta = event.clientY - dragStart;
      if (Math.abs(delta) > 4) moved = true;
      render(heightStart + delta);
    });

    const release = (event: PointerEvent) => {
      if (menu.dataset.dragging !== "true") return;
      menu.dataset.dragging = "false";
      if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
      if (!moved) toggle();
      else if (height <= 48) render(0);
    };

    handle.addEventListener("pointerup", release);
    handle.addEventListener("pointercancel", release);

    handle.addEventListener("keydown", (event) => {
      const step = 40;
      if (event.key === "ArrowDown") render(height + step);
      else if (event.key === "ArrowUp") render(height - step);
      else if (event.key === "Home") render(0);
      else if (event.key === "End") render(maxHeight());
      else if (event.key === "Enter" || event.key === " ") toggle();
      else return;
      event.preventDefault();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") render(0);
    });

    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => render(0)));

    const zoom = menu.querySelector<HTMLElement>(".menu__zoom");
    const zoomText = zoom?.querySelector<HTMLElement>("span");
    let leaveTimer = 0;

    const zoomLinks = Array.from(menu.querySelectorAll<HTMLElement>(".menu__nav a, .menu__socials a"));
    const labelOf = (link: HTMLElement) =>
      link.dataset.zoomLabel ?? link.querySelector(".menu__label")?.textContent?.trim() ?? link.textContent?.trim() ?? "";
    let zoomSize = 0;

    const measureZoom = () => {
      if (!zoom || !zoomText) return 0;
      zoomText.style.fontSize = "100px";
      let widest = 1;
      let tallest = 1;
      new Set(zoomLinks.map(labelOf)).forEach((label) => {
        zoomText.textContent = label;
        widest = Math.max(widest, zoomText.offsetWidth);
        tallest = Math.max(tallest, zoomText.offsetHeight);
      });
      return 100 * Math.min((zoom.clientWidth - 64) / widest, (zoom.clientHeight - 224) / tallest);
    };

    const showZoom = (link: HTMLElement) => {
      if (!zoom || !zoomText) return;
      window.clearTimeout(leaveTimer);
      if (!zoomSize) zoomSize = measureZoom();
      zoomText.textContent = labelOf(link);
      zoomText.style.fontSize = `${zoomSize}px`;
      const linkBox = link.getBoundingClientRect();
      const sheetBox = sheet.getBoundingClientRect();
      zoom.style.setProperty("--ox", `${linkBox.left + linkBox.width / 2 - sheetBox.left}px`);
      zoom.style.setProperty("--oy", `${linkBox.top + linkBox.height / 2 - sheetBox.top}px`);
      menu.dataset.zoom = "true";
    };

    const hideZoom = () => {
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => {
        menu.dataset.zoom = "false";
      }, 60);
    };

    window.addEventListener("resize", () => {
      zoomSize = 0;
    });

    zoomLinks.forEach((link) => {
      link.addEventListener("pointerenter", () => showZoom(link));
      link.addEventListener("pointerleave", hideZoom);
      link.addEventListener("focus", () => showZoom(link));
      link.addEventListener("blur", hideZoom);
    });
    window.addEventListener("resize", () => render(Math.min(height, maxHeight())));
    shape(height);

    const aboutBox = menu.querySelector<HTMLElement>("[data-about]");
    const aboutToggle = menu.querySelector<HTMLButtonElement>("[data-about-toggle]");
    const story = menu.querySelector<HTMLElement>("[data-story]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ease = "expo.out";

    const split = (root: Element) => {
      root.querySelectorAll<HTMLElement>("[data-split]").forEach((block) => {
        if (block.dataset.done) return;
        block.dataset.done = "1";
        const words = (block.textContent ?? "").trim().split(/\s+/);
        block.textContent = "";
        words.forEach((word, index) => {
          const wrap = document.createElement("span");
          wrap.className = "split-word";
          Array.from(word).forEach((letter) => {
            const char = document.createElement("span");
            char.className = "split-char";
            char.textContent = letter;
            wrap.append(char);
          });
          block.append(wrap);
          if (index < words.length - 1) block.append(" ");
        });
      });
    };

    const write = (root: Element, delay = 0) => {
      split(root);
      const blocks = Array.from(root.querySelectorAll<HTMLElement>("[data-split]"));
      const timeline = gsap.timeline({ delay });
      blocks.forEach((block, index) => {
        const chars = block.querySelectorAll(".split-char");
        timeline.fromTo(
          chars,
          { opacity: 0, yPercent: 60, filter: "blur(6px)" },
          { opacity: 1, yPercent: 0, filter: "blur(0px)", duration: reduced ? 0 : 0.9, ease, stagger: reduced ? 0 : 0.014 },
          index === 0 ? 0 : `<${reduced ? 0 : 0.18}`
        );
      });
      return timeline;
    };

    const erase = (root: Element) =>
      gsap.to(root.querySelectorAll(".split-char"), {
        opacity: 0,
        yPercent: -50,
        filter: "blur(6px)",
        duration: reduced ? 0 : 0.5,
        ease: "power2.in",
        stagger: { each: reduced ? 0 : 0.003, from: "start" }
      });

    if (aboutBox) split(aboutBox);
    aboutToggle?.addEventListener("click", () => {
      if (!aboutBox) return;
      const open = !aboutBox.classList.contains("is-open");
      aboutToggle.setAttribute("aria-expanded", String(open));
      if (open) {
        aboutBox.classList.add("is-open");
        write(aboutBox);
      } else {
        erase(aboutBox).eventCallback("onComplete", () => aboutBox.classList.remove("is-open"));
      }
    });

    const html = document.documentElement;
    if (html.hasAttribute("data-intro") && story) {
      try {
        sessionStorage.setItem("intro-seen", "1");
      } catch {}
      menu.dataset.dragging = "true";
      menu.classList.add("is-intro");
      menu.dataset.open = "true";
      html.style.setProperty("--h", `${window.innerHeight}px`);
      shape(window.innerHeight);
      sheet.setAttribute("inert", "");
      split(story);
      gsap.set(story.querySelectorAll(".split-char"), { opacity: 0 });
      const main = document.querySelector("main");
      if (main) gsap.set(main, { y: 60, opacity: 0.4 });

      const close = () => {
        const state = { value: window.innerHeight };
        html.removeAttribute("data-intro");
        erase(story);
        const timeline = gsap.timeline({
          onComplete: () => {
            menu.classList.remove("is-intro");
            menu.dataset.dragging = "false";
            render(0);
            if (main) gsap.set(main, { clearProps: "all" });
          }
        });
        timeline.to(
          state,
          {
            value: 0,
            duration: reduced ? 0 : 1.6,
            ease: "expo.inOut",
            onUpdate: () => {
              document.documentElement.style.setProperty("--h", `${state.value}px`);
              shape(state.value);
            }
          },
          reduced ? 0 : 0.35
        );
        if (main) timeline.to(main, { y: 0, opacity: 1, duration: reduced ? 0 : 1.6, ease: "expo.out" }, reduced ? 0 : 0.75);
      };

      document.fonts.ready.then(() => {
        write(story, reduced ? 0 : 0.35).eventCallback("onComplete", () => gsap.delayedCall(reduced ? 0.2 : 1.1, close));
      });
    }
  }
</script>
