---
import type { Lang } from "../../data/i18n";
import { navItems, socials } from "../../data/site";
import { localePath, useUi } from "../../lib/i18n";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const copy = ui.footer;
const email = socials.find((social) => social.id === "email");
const networks = socials.filter((social) => social.id !== "email");
---

<footer class="footer">
  <p class="footer__giant">{copy.giant}</p>

  <div class="footer__grid">
    <div class="footer__cell">
      <p class="footer__head">{copy.info}</p>
      <p class="footer__small">Thomas Perruchot<br />{copy.role}</p>
    </div>

    <div class="footer__cell">
      <p class="footer__head">{ui.cta.emailLabel}</p>
      {email && <a class="footer__small footer__link" href={email.href}>{email.label}</a>}
      <p class="footer__head footer__head--gap">{ui.cta.socialLabel}</p>
      <ul class="footer__small footer__list">
        {
          networks.map((social) => (
            <li>
              <a class="footer__link" href={social.href} target="_blank" rel="noopener noreferrer">
                {social.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__cell">
      <p class="footer__head">{copy.navigate}</p>
      <ul class="footer__small footer__list">
        {
          navItems.map((item) => (
            <li>
              <a class="footer__link" href={localePath(lang, item.path)}>{ui.nav[item.key]}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__cell footer__cell--end">
      <p class="footer__head">{copy.language}</p>
      <div class="footer__small footer__lang">
        <LangSwitch lang={lang} />
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <p class="footer__small">{copy.rights}</p>
    <p class="footer__small footer__tagline">{copy.tagline}</p>
    <a class="footer__small footer__link footer__top" href="#top">[ {copy.back} ]</a>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 5svh;
    padding: 6svh var(--gutter) 2.5svh;
    background: var(--color-black);
    color: var(--color-white);
  }

  .footer__giant {
    margin: 0;
    align-self: flex-end;
    font-size: var(--text-giant);
    line-height: var(--text-giant--line-height);
    letter-spacing: -0.02em;
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2vw;
    padding-top: 1.2em;
    border-top: 1px solid var(--color-grey);
  }

  .footer__cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__cell--end {
    align-items: flex-end;
  }

  .footer__head {
    margin: 0 0 0.5em;
    color: var(--color-grey);
    font-size: var(--text-copy);
    line-height: var(--text-copy--line-height);
  }

  .footer__head--gap {
    margin-top: 1.6em;
  }

  .footer__small {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-copy);
    line-height: var(--text-copy--line-height);
    font-weight: var(--font-weight-regular);
  }

  .footer__link {
    color: inherit;
    transition: opacity 0.25s ease;
  }

  .footer__link:hover {
    opacity: 0.55;
  }

  .footer__lang :global(nav) {
    font-size: var(--text-copy);
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 2vw;
    margin-top: 8svh;
  }

  .footer__tagline {
    max-width: 24em;
    text-align: center;
  }

  .footer__top {
    justify-self: end;
  }

  @media (max-width: 767px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 4svh;
    }

    .footer__bottom {
      grid-template-columns: 1fr;
    }

    .footer__tagline {
      text-align: left;
    }

    .footer__top {
      justify-self: start;
    }
  }
</style>
