---
import type { Lang } from "../../data/i18n";
import footerRaw from "../../assets/footer.svg?raw";
import { navItems } from "../../data/site";
import { localePath, useUi } from "../../lib/i18n";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const footerPath = footerRaw.match(/<path d="([^"]+)"/)?.[1] ?? "";
const crop = { x: 694, y: 0, width: 1317, height: 660 };
---

<footer class="footer">
  <div class="footer__stage" style={`--ratio:${crop.width / crop.height}`}>
    <svg
      class="footer__shape"
      viewBox={`${crop.x} ${crop.y} ${crop.width} ${crop.height}`}
      preserveAspectRatio="xMidYMax slice"
      aria-hidden="true"
    >
      <path d={footerPath} fill="currentColor"></path>
    </svg>
    <nav class="footer__nav" aria-label={ui.menuLabel}>
      {navItems.map((item) => <a href={localePath(lang, item.path)}>{ui.nav[item.key]}</a>)}
      <a class="footer__top" href="#top">{ui.footer.top}</a>
    </nav>
    <div class="footer__bottom">
      <p class="footer__credit">{ui.footer.credit}</p>
      <p class="footer__thanks">{ui.footer.thanks}</p>
      <LangSwitch lang={lang} />
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    margin-top: 6rem;
    color: var(--color-black);
  }

  .footer__stage {
    position: relative;
    width: 100%;
    min-height: 32rem;
    aspect-ratio: var(--ratio);
    color: var(--color-white);
  }

  .footer__shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-black);
  }

  .footer__nav {
    position: absolute;
    inset-inline: 1.5rem;
    top: 57%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 2.5rem;
    transform: translateY(-50%);
    font-size: var(--text-small);
    font-weight: var(--font-weight-regular);
    line-height: var(--text-small--line-height);
  }

  .footer__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer__top {
    padding: 0.9rem;
    background: var(--color-white);
    color: var(--color-black);
  }

  .footer__top:hover {
    text-decoration: none;
  }

  .footer__bottom {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.25rem 0.75rem;
    font-size: var(--text-small);
    font-weight: var(--font-weight-regular);
    line-height: var(--text-small--line-height);
  }

  .footer__thanks {
    order: -1;
    padding: 0 0.3em;
    background: var(--color-white);
    color: var(--color-black);
    font-size: var(--text-display);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .footer__nav {
      inset-inline: 13.6% 15.6%;
      justify-content: space-between;
    }

    .footer__bottom {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding: 0 1rem 0.75rem;
    }

    .footer__thanks {
      order: 0;
      margin-bottom: -0.75rem;
    }
  }
</style>
