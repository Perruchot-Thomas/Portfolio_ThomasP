---
import type { Lang } from "../../data/i18n";
import { navItems, socials } from "../../data/site";
import { localePath, useUi } from "../../lib/i18n";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const copy = ui.footer;
const email = socials.find((social) => social.id === "email");
const networks = socials.filter((social) => social.id !== "email");
---

<footer class="footer">
  <p class="footer__giant">{copy.giant}</p>

  <div class="footer__grid">
    <div class="footer__cell">
      <p class="footer__head">{copy.info}</p>
      <p class="footer__small">Thomas Perruchot<br />{copy.role}</p>
    </div>

    <div class="footer__cell">
      <p class="footer__head">{copy.internship}</p>
      <p class="footer__small">{copy.internshipText}</p>
      <a class="footer__small footer__link footer__more" href={localePath(lang, "/contact")}>[ {copy.internshipLink} ↗ ]</a>
    </div>

    <div class="footer__cell">
      <p class="footer__head">{ui.cta.emailLabel}</p>
      {email && <a class="footer__small footer__link" href={email.href}>{email.label}</a>}
      <p class="footer__head footer__head--gap">{ui.cta.socialLabel}</p>
      <ul class="footer__small footer__list">
        {
          networks.map((social) => (
            <li>
              <a class="footer__link" href={social.href} target="_blank" rel="noopener noreferrer">
                {social.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__cell">
      <p class="footer__head">{copy.navigate}</p>
      <ul class="footer__small footer__list">
        {
          navItems.map((item) => (
            <li>
              <a class="footer__link" href={localePath(lang, item.path)}>{ui.nav[item.key]}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__cell footer__cell--end">
      <p class="footer__head">{copy.language}</p>
      <div class="footer__small footer__lang">
        <LangSwitch lang={lang} />
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <p class="footer__small">{copy.rights}</p>
    <a class="footer__small footer__link" href={localePath(lang, "/legal")}>[ {copy.legal} ]</a>
    <a class="footer__small footer__link footer__top" href="#top">[ {copy.back} ]</a>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 5svh;
    padding: 6svh var(--gutter) 2.5svh;
    background: var(--color-black);
    color: var(--color-white);
  }

  .footer__giant {
    margin: 0;
    align-self: flex-end;
    font-size: var(--text-giant);
    line-height: var(--text-giant--line-height);
    letter-spacing: -0.02em;
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2vw;
    padding-top: 1.2em;
    border-top: 1px solid var(--color-grey);
  }

  .footer__cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__cell--end {
    align-items: flex-end;
  }

  .footer__head {
    margin: 0 0 0.5em;
    color: var(--color-grey);
    font-size: var(--text-copy);
    line-height: var(--text-copy--line-height);
  }

  .footer__head--gap {
    margin-top: 1.6em;
  }

  .footer__small {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-copy);
    line-height: var(--text-copy--line-height);
    font-weight: var(--font-weight-regular);
  }

  .footer__link {
    color: inherit;
  }

  .footer__lang :global(nav) {
    font-size: var(--text-copy);
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: end;
    gap: 2vw;
    margin-top: 8svh;
  }

  .footer__more {
    display: inline-block;
    margin-top: 0.8em;
  }

  .footer__top {
    justify-self: end;
  }

  @media (max-width: 767px) {
    .footer {
      gap: 0;
      padding: 10svh var(--gutter) calc(env(safe-area-inset-bottom) + 1.5rem);
    }

    .footer__giant {
      align-self: flex-start;
      margin-bottom: 6svh;
    }

    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-top: 0;
      border-top: 0;
    }

    .footer__cell {
      align-items: stretch;
      padding: 1.4rem 0 0.6rem;
      border-top: 1px solid rgb(255 255 255 / 0.22);
    }

    .footer__cell--end {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 1.4rem;
    }

    .footer__cell--end .footer__head {
      margin: 0;
    }

    .footer__head--gap {
      margin-top: 1.4rem;
    }

    .footer__cell > .footer__small:not(.footer__link):not(.footer__list):not(.footer__lang) {
      margin-bottom: 0.8rem;
    }

    .footer__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      border-bottom: 1px solid rgb(255 255 255 / 0.12);
      overflow-wrap: anywhere;
    }

    .footer__list li:last-child .footer__link,
    .footer__cell > .footer__link:last-child {
      border-bottom: 0;
    }

    .footer__more {
      margin-top: 0;
    }

    .footer__bottom {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      margin-top: 0;
      padding-top: 0.6rem;
      border-top: 1px solid rgb(255 255 255 / 0.22);
    }

    .footer__bottom > p {
      order: 3;
      padding-top: 1.2rem;
      color: var(--color-grey);
    }

    .footer__top {
      justify-self: stretch;
      justify-content: center;
      margin-top: 0.8rem;
      border: 1px solid rgb(255 255 255 / 0.4);
      border-bottom: 1px solid rgb(255 255 255 / 0.4);
    }
  }
</style>
