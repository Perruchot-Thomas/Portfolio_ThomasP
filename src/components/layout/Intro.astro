---
import type { Lang } from "../../data/i18n";
import { useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
---

<div id="intro" class="intro" aria-hidden="true" data-label={ui.handle}>
  <div class="intro__row">
    <p class="intro__item">{ui.loader.name}</p>
    <p class="intro__item intro__muted">{ui.loader.role}</p>
  </div>
  <div class="intro__center">
    <p class="intro__line intro__item">
      <span class="intro__text" data-intro-text></span>
      <svg class="intro__star" data-intro-star viewBox="-10 -10 20 20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="butt">
        <path d="M0 -9V9M-7.8 -4.5L7.8 4.5M-7.8 4.5L7.8 -4.5"></path>
      </svg>
    </p>
  </div>
  <div class="intro__foot">
    <div class="intro__row">
      <p class="intro__item intro__muted">{ui.loader.loading}</p>
      <p class="intro__item"><span data-intro-count>000</span></p>
      <p class="intro__item intro__muted">{ui.loader.year}</p>
    </div>
  </div>
</div>

<style>
  :global(html[data-intro]),
  :global(html[data-intro] body) {
    overflow: hidden;
  }

  .intro {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 1.25rem;
    background: var(--color-white);
    color: var(--color-black);
    visibility: hidden;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .intro {
      padding: 1.5rem 2rem;
    }
  }

  :global(html[data-intro]) .intro {
    visibility: visible;
    pointer-events: auto;
  }

  :global(html[data-intro]) .intro__item {
    opacity: 0;
  }

  .intro__row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    font-weight: var(--font-weight-regular);
  }

  .intro__muted {
    color: var(--color-grey);
  }

  .intro__center {
    display: grid;
    place-items: center;
  }

  .intro__line {
    display: flex;
    align-items: flex-start;
    gap: 0.12em;
    font-size: var(--text-display);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .intro__star {
    flex: none;
    width: 0.4em;
    height: 0.4em;
    margin-top: 0.08em;
  }

  .intro__foot {
    display: grid;
  }

  [data-intro-count] {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { scramble } from "../../lib/scramble";

  const root = document.getElementById("intro");
  const html = document.documentElement;

  if (root && html.hasAttribute("data-intro")) {
    sessionStorage.setItem("intro-seen", "1");

    const text = root.querySelector<HTMLElement>("[data-intro-text]")!;
    const star = root.querySelector<SVGElement>("[data-intro-star]")!;
    const count = root.querySelector<HTMLElement>("[data-intro-count]")!;
    const items = root.querySelectorAll<HTMLElement>(".intro__item");
    const meta = Array.from(items).filter((item) => !item.classList.contains("intro__line"));
    const line = root.querySelector<HTMLElement>(".intro__line")!;
    const label = root.dataset.label ?? "";
    const progress = { value: 0 };

    text.textContent = label;
    gsap.set(items, { opacity: 0 });
    gsap.set(meta, { y: 10 });

    const loaded = new Promise<void>((resolve) => {
      const ready = () => document.fonts.ready.then(() => resolve());
      if (document.readyState === "complete") ready();
      else window.addEventListener("load", ready, { once: true });
    });

    const spin = gsap.to(star, { rotation: 360, duration: 2.4, ease: "none", repeat: -1, transformOrigin: "50% 50%" });

    const finish = () => {
      html.removeAttribute("data-intro");
      spin.kill();
      gsap.set(root, { clearProps: "all" });
    };

    const exit = () => {
      gsap
        .timeline({ onComplete: finish })
        .to(meta, { opacity: 0, duration: 0.35, ease: "power2.out" })
        .to(line, { yPercent: -40, opacity: 0, duration: 0.6, ease: "power3.in" }, "<0.1")
        .to(root, { yPercent: -100, duration: 1, ease: "power4.inOut" }, "-=0.2");
    };

    gsap
      .timeline({ onComplete: () => loaded.then(exit) })
      .to(meta, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", stagger: 0.08 }, 0)
      .fromTo(line, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0.15)
      .add(() => scramble(text, label, 1.3), 0.3)
      .to(
        progress,
        {
          value: 100,
          duration: 2.4,
          ease: "power2.inOut",
          onUpdate: () => {
            count.textContent = String(Math.round(progress.value)).padStart(3, "0");
          }
        },
        0.3
      )
      .to({}, { duration: 0.35 });
  }
</script>
