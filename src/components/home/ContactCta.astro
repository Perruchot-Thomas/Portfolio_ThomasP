---
import type { Lang } from "../../data/i18n";
import { localePath, useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const contactHref = localePath(lang, "/contact");
const lines = ui.cta.lines.map((line) => line.split(" ").map((word) => Array.from(word)));
const modules = import.meta.glob<{ src: string }>(
  [
    "../../assets/projets/*.{jpg,jpeg,png,webp,avif}",
    "../../assets/collage/*.{jpg,jpeg,png,webp,avif}",
    "../../assets/photos/*.{jpg,jpeg,webp,avif}",
    "../../assets/textures/*.{jpg,jpeg,png,webp,avif}",
    "../../assets/texture hero/*.{jpg,jpeg,png,webp,avif}"
  ],
  { eager: true, import: "default" }
);
const sources = Array.from(new Set(Object.values(modules).map((image) => image.src)));
---

<section class="talk">
  <div class="talk__top">
    <p class="talk__small">{ui.cta.kicker}</p>
    <p class="talk__small">{ui.cta.city} <span data-clock>--:--</span></p>
    <p class="talk__small talk__right">{ui.cta.text}</p>
  </div>

  <div class="talk__row">
    <a class="talk__title" href={contactHref} aria-label={ui.cta.lines.join(" ")} data-letters data-sources={JSON.stringify(sources)}>
      {
        lines.map((words) => (
          <span class="talk__line" aria-hidden="true">
            {words.map((letters, index) => (
              <>
                {index > 0 && " "}
                <span class="talk__word">
                  {letters.map((letter) => <span class="talk__letter" data-letter>{letter}</span>)}
                </span>
              </>
            ))}
          </span>
        ))
      }
    </a>

    <a class="talk__go" href={contactHref} aria-label={ui.cta.button}>
      <span aria-hidden="true">[</span>
      <svg viewBox="0 0 100 100" aria-hidden="true"><path d="M22 78 L78 22 M34 22 H78 V66" /></svg>
      <span aria-hidden="true">]</span>
    </a>
  </div>
</section>

<style>
  .talk {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8svh;
    padding: 18svh var(--gutter) 0;
    background: var(--color-white);
    color: var(--color-black);
  }

  .talk__top {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2vw;
  }

  .talk__small {
    margin: 0;
    font-size: var(--text-copy);
    line-height: var(--text-copy--line-height);
    font-weight: var(--font-weight-regular);
  }

  .talk__right {
    justify-self: end;
    text-align: right;
  }

  .talk__row {
    display: flex;
    align-items: last baseline;
    justify-content: space-between;
    gap: 2vw;
    margin-bottom: -0.02em;
  }

  .talk__title {
    display: flex;
    flex-direction: column;
    color: var(--color-black);
    font-size: var(--text-giant);
    line-height: var(--text-giant--line-height);
    letter-spacing: -0.02em;
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .talk__word {
    display: inline-block;
  }

  .talk__letter {
    position: relative;
    display: inline-block;
  }

  .talk__letter.is-image {
    color: transparent;
  }

  .talk__letter :global(img) {
    position: absolute;
    top: 0.04em;
    left: 0;
    display: none;
    width: 100%;
    height: 0.711em;
    max-width: none;
    object-fit: cover;
    pointer-events: none;
  }

  .talk__letter.is-image :global(img) {
    display: block;
  }

  .talk__go {
    display: flex;
    align-items: center;
    gap: 0.05em;
    color: var(--color-black);
    font-size: var(--text-mid);
    line-height: 1;
  }

  .talk__go svg {
    width: 0.62em;
    height: 0.62em;
    fill: none;
    stroke: currentColor;
    stroke-width: 9;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .talk__go:hover svg {
    transform: translate(0.06em, -0.06em);
  }
</style>

<script>
  const clock = document.querySelector<HTMLElement>("[data-clock]");

  if (clock) {
    const format = new Intl.DateTimeFormat("fr-FR", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Paris" });
    const tick = () => {
      clock.textContent = format.format(new Date());
    };
    tick();
    window.setInterval(tick, 20000);
  }

  const title = document.querySelector<HTMLElement>("[data-letters]");

  if (title) {
    const sources: string[] = JSON.parse(title.dataset.sources ?? "[]");
    const letters = Array.from(title.querySelectorAll<HTMLElement>("[data-letter]"));
    let turn = -1;

    if (sources.length) {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const swaps = letters.map((letter) => {
        let timer = 0;
        const image = document.createElement("img");
        image.alt = "";
        image.draggable = false;
        letter.append(image);
        const show = (duration: number) => {
          window.clearTimeout(timer);
          let pick = Math.floor(Math.random() * sources.length);
          if (pick === turn && sources.length > 1) pick = (pick + 1) % sources.length;
          turn = pick;
          image.src = sources[pick];
          letter.classList.add("is-image");
          if (duration > 0) timer = window.setTimeout(() => letter.classList.remove("is-image"), duration);
        };
        letter.addEventListener("pointerenter", () => show(0));
        letter.addEventListener("pointerleave", () => {
          timer = window.setTimeout(() => letter.classList.remove("is-image"), 600);
        });
        return show;
      });

      if (!reduced) {
        let visible = false;
        new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
        }).observe(title);
        window.setInterval(() => {
          if (!visible) return;
          const count = Math.random() < 0.35 ? 2 : 1;
          for (let index = 0; index < count; index += 1) {
            swaps[Math.floor(Math.random() * swaps.length)](700 + Math.random() * 900);
          }
        }, 380);
      }
    }
  }
</script>
