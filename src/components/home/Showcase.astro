---
import type { Lang } from "../../data/i18n";
import { getImage } from "astro:assets";
import { getProjects } from "../../data/projects";
import { galleryCover } from "../../data/artGallery";
import { localePath, useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const copy = ui.showcase;
const pad = (value: number) => String(value).padStart(2, "0");

const projects = (await getProjects()).filter((project) => project.home);
const items = await Promise.all(
  projects.map(async (project) => {
    const image = await getImage({ src: project.cover, width: 900, format: "webp", quality: 80 });
    return {
      name: project.name,
      kind: ui.projectsPage[project.category],
      category: project.category as string,
      image: { src: image.src, width: Number(image.attributes.width), height: Number(image.attributes.height) },
      href: localePath(lang, `/projects/${project.slug}`)
    };
  })
);
const folder = await getImage({ src: galleryCover, width: 900, format: "webp", quality: 85 });
items.push({
  name: ui.artGallery.name,
  kind: ui.artGallery.label,
  category: "gallery",
  image: { src: folder.src, width: Number(folder.attributes.width), height: Number(folder.attributes.height) },
  href: localePath(lang, "/galerie")
});

const start = Math.min(2, items.length - 1);
const categories = (["posters", "covers", "web"] as const).filter((category) => items.some((item) => item.category === category));
const filters = [{ key: "all", label: ui.projectsPage.all }, ...categories.map((category) => ({ key: category, label: ui.projectsPage[category] }))];
---

<section class="show" data-show data-start={start}>
  <h1 class="show__hidden">{ui.handle} — {ui.aboutPage.role.join(" ")}</h1>

  <div class="show__top">
    <p class="show__small"><span data-current>{pad(start + 1)}</span> / <span data-total>{pad(items.length)}</span> {copy.works}</p>
    <div class="show__filters" role="group">
      {
        filters.map((filter, index) => (
          <button class:list={["show__small", "show__filter", index === 0 && "is-active"]} type="button" data-filter={filter.key} aria-pressed={index === 0 ? "true" : "false"}>
            [ {filter.label.toLowerCase()} ]
          </button>
        ))
      }
    </div>
    <span></span>
  </div>

  <div class="show__stage" data-stage>
    <div class="show__ring" data-ring>
      {
        items.map((item, index) => (
          <figure class:list={["show__card", item.category === "gallery" && "show__card--folder"]} data-card data-category={item.category} data-label={item.category === "gallery" ? `[ ${ui.artGallery.open} ↗ ]` : `[ ${copy.go} ↗ ]`} data-href={item.href} data-kind={item.kind} data-name={item.name} data-ratio={(item.image.width / item.image.height).toFixed(4)} style={`--ratio:${(item.image.width / item.image.height).toFixed(4)}`}>
            <img src={item.image.src} width={item.image.width} height={item.image.height} alt={item.name} draggable="false" loading={index < 6 ? "eager" : "lazy"} />
          </figure>
        ))
      }
    </div>

    <p class="show__small show__caption" aria-live="polite">
      <span class="show__grey" data-caption-num>({pad(start + 1)})</span>
      <span data-caption-name>{items[start]?.name}</span>
    </p>
  </div>

  <div class="show__foot">
    <a class="show__small show__talk" href={localePath(lang, "/contact")}>[ {copy.talk} ↗ ]</a>
    <button class="show__small show__unlock" type="button" data-unlock>[ {ui.footer.unlock} ↓ ]</button>
    <p class="show__small show__grey">© SIDUS — 2026</p>
  </div>
</section>

<style>
  .show {
    --case: 270px;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100svh;
    padding: 11svh var(--gutter) 4svh;
    overflow: hidden;
    color: var(--color-black);
    background: var(--color-white);
    user-select: none;
  }

  .show__hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .show__small {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    font-weight: var(--font-weight-regular);
  }

  .show__grey {
    color: var(--color-grey);
  }

  .show__top {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 2vw;
  }

  .show__filters {
    display: flex;
    gap: 1.2vw;
  }

  .show__filter {
    white-space: nowrap;
    cursor: pointer;
    color: var(--color-grey);
    transition: color 0.3s ease;
  }

  .show__filter:hover,
  .show__filter.is-active {
    color: var(--color-black);
  }

  .show__unlock {
    cursor: pointer;
  }

  :global(html.is-locked),
  :global(html.is-locked body) {
    overflow: hidden;
  }


  .show__stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    perspective: 1600px;
    perspective-origin: 50% 50%;
    cursor: grab;
    touch-action: none;
  }

  .show__stage.is-dragging {
    cursor: grabbing;
  }

  .show__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  .show__card[hidden] {
    display: none;
  }

  .show__card {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--case) * var(--ratio, 1));
    height: var(--case);
    margin: 0;
    overflow: hidden;
    transform-origin: 50% 50%;
    backface-visibility: visible;
    will-change: transform;
  }

  .show.is-switching .show__card {
    transition:
      transform 0.9s cubic-bezier(0.45, 0, 0.15, 1),
      opacity 0.9s ease;
  }

  .show__card--folder {
    display: grid;
    place-items: center;
    overflow: visible;
  }

  .show__card.show__card--folder img {
    width: 68%;
    height: auto;
    object-fit: contain;
  }

  .show__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .show__caption {
    position: absolute;
    top: calc(50% + var(--case) / 2 + 1.2em);
    left: 50%;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    gap: 1em;
    width: max(var(--case), 16em);
    white-space: nowrap;
    pointer-events: none;
    transform: translateX(-50%);
    transition:
      top 0.9s cubic-bezier(0.45, 0, 0.15, 1),
      opacity 0.4s ease;
  }







  .show__foot {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2vw;
    margin-top: auto;
  }

  .show__talk {
    padding: 0.5em 0.8em;
    background: var(--color-black);
    color: var(--color-white);
  }

  @media (max-width: 1100px) {
    .show__top {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .show__top > span:last-child {
      display: none;
    }

    .show__filters {
      justify-content: flex-end;
    }
  }

  @media (max-width: 767px) and (orientation: portrait) {
    .show {
      padding-top: 10svh;
    }

    .show__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.2svh;
    }

    .show__filters {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.4em 0.9em;
    }

    .show__caption {
      width: calc(100vw - var(--gutter) * 2);
    }

    .show__foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (orientation: landscape) and (max-height: 520px) {
    .show {
      padding-top: 15svh;
    }
  }
</style>

<script>
  import { goFrom } from "../../lib/wipe";
  import { getScroll } from "../../lib/scroll";

  const show = document.querySelector<HTMLElement>("[data-show]");
  const stage = show?.querySelector<HTMLElement>("[data-stage]");
  const ring = show?.querySelector<HTMLElement>("[data-ring]");

  if (show && stage && ring) {
    const cards = Array.from(ring.querySelectorAll<HTMLElement>("[data-card]"));
    const filters = Array.from(show.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const current = show.querySelector<HTMLElement>("[data-current]");
    const total = show.querySelector<HTMLElement>("[data-total]");
    const captionNum = show.querySelector<HTMLElement>("[data-caption-num]");
    const captionName = show.querySelector<HTMLElement>("[data-caption-name]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const pad = (value: number) => String(value).padStart(2, "0");

    let deck = cards.slice();
    let count = deck.length;
    const wrap = (value: number) => value - count * Math.round(value / count);
    const modulo = (value: number) => ((value % count) + count) % count;

    let size = 270;
    let radius = 720;
    let step = 275;
    let pos = Number(show.dataset.start ?? 0);
    let goal: number | null = null;
    let velocity = 0;
    let speed = 0;
    let previous = pos;
    let tilt = 0;
    let active = -1;
    let switching = 0;
    let dragging = false;
    let moved = 0;
    let startX = 0;
    let startY = 0;
    let startPos = 0;
    let startTilt = 0;
    let lastX = 0;
    let lastMove = 0;

    const measure = () => {
      const width = window.innerWidth;
      const height = window.innerHeight;
      size = width < 768 && height > width ? Math.min(width * 0.52, height * 0.34) : height > width ? Math.min(width * 0.4, height * 0.3) : Math.min(270 * clamp(Math.min(width / 1440, height / 850), 0.6, 1.6), height * 0.36);
      radius = size * (720 / 270) * clamp(count / 12, 0.45, 1.4);
      step = size * (275 / 270);
      show.style.setProperty("--case", `${size.toFixed(1)}px`);
    };

    const setActive = (index: number) => {
      if (index === active) return;
      active = index;
      const card = deck[index];
      if (!card) return;
      cards.forEach((item) => item.classList.toggle("is-active", item === card));
      if (current) current.textContent = pad(index + 1);
      if (captionNum) captionNum.textContent = `(${pad(index + 1)})`;
      if (captionName) captionName.textContent = card.dataset.name ?? "";
    };

    const setFilter = (key: string) => {
      filters.forEach((filter) => {
        const on = filter.dataset.filter === key;
        filter.classList.toggle("is-active", on);
        filter.setAttribute("aria-pressed", on ? "true" : "false");
      });
      deck = cards.filter((card) => key === "all" || card.dataset.category === key);
      cards.forEach((card) => (card.hidden = !deck.includes(card)));
      count = deck.length;
      if (total) total.textContent = pad(count);
      pos = 0;
      previous = 0;
      goal = null;
      velocity = 0;
      active = -1;
      measure();
      show.classList.add("is-switching");
      window.clearTimeout(switching);
      switching = window.setTimeout(() => show.classList.remove("is-switching"), 900);
    };

    const frame = () => {
      if (!dragging) {
        if (goal !== null) {
          pos += (goal - pos) * (reduced ? 1 : 0.12);
          velocity = 0;
          if (Math.abs(goal - pos) < 0.001) {
            pos = goal;
            goal = null;
          }
        } else {
          pos += velocity;
          velocity *= 0.93;
          if (Math.abs(velocity) < 0.02) {
            pos += (Math.round(pos) - pos) * 0.05;
            if (Math.abs(velocity) < 0.00003) velocity = 0;
          }
        }
        tilt += (0 - tilt) * 0.08;
      }
      ring.style.transform = `translateZ(${(-radius).toFixed(1)}px) rotateX(${tilt.toFixed(2)}deg)`;

      const delta = pos - previous;
      previous = pos;
      speed += (delta - speed) * 0.25;
      const skew = clamp(speed * 55, -22, 22);
      const shrink = 1 - Math.min(Math.abs(speed) * 1.4, 0.14);

      deck.forEach((card, index) => {
        const d = count > 1 ? wrap(index - pos) : 0;
        const angle = d * (360 / Math.max(count, 1));
        const flip = Math.abs(angle) > 90 ? " scaleX(-1)" : "";
        card.style.transform = `translate(-50%, -50%) rotateY(${angle.toFixed(2)}deg) translateZ(${radius.toFixed(1)}px) scale(${shrink.toFixed(3)}) skewX(${skew.toFixed(2)}deg)${flip}`;
      });

      if (count) setActive(modulo(Math.round(pos)));
      requestAnimationFrame(frame);
    };

    const nearest = (index: number) => pos + wrap(index - pos);
    const goTo = (index: number) => {
      goal = Math.round(nearest(index));
    };

    const html = document.documentElement;
    const unlock = show.querySelector<HTMLButtonElement>("[data-unlock]");
    let locked = true;
    let away = false;

    const lock = () => {
      locked = true;
      away = false;
      html.classList.add("is-locked");
      getScroll()?.stop();
    };

    const openFooter = () => {
      locked = false;
      html.classList.remove("is-locked");
      const lenis = getScroll();
      lenis?.start();
      const footer = document.querySelector<HTMLElement>("footer");
      if (!footer) return;
      if (lenis) lenis.scrollTo(footer, { duration: 1.4 });
      else footer.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
    };

    unlock?.addEventListener("click", openFooter);
    window.addEventListener("scroll", () => {
      if (locked) return;
      if (window.scrollY > 80) away = true;
      if (away && window.scrollY < 4) lock();
    });
    lock();
    window.setTimeout(() => {
      if (locked) getScroll()?.stop();
    }, 0);

    show.addEventListener(
      "wheel",
      (event) => {
        if (!locked) return;
        event.preventDefault();
        event.stopPropagation();
        const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        goal = null;
        velocity += delta * 0.00028;
      },
      { passive: false }
    );

    stage.addEventListener("pointerdown", (event) => {
      if (!locked) return;
      dragging = true;
      moved = 0;
      goal = null;
      velocity = 0;
      startX = lastX = event.clientX;
      startY = event.clientY;
      startPos = pos;
      startTilt = tilt;
      lastMove = 0;
      stage.classList.add("is-dragging");
      stage.setPointerCapture(event.pointerId);
    });

    stage.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      moved = Math.max(moved, Math.abs(dx), Math.abs(dy));
      lastMove = event.clientX - lastX;
      lastX = event.clientX;
      pos = startPos - dx / (step * 1.6);
      tilt = clamp(startTilt - dy * 0.03, -14, 14);
    });

    const release = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      stage.classList.remove("is-dragging");
      if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
      velocity = -lastMove / (step * 1.6);
      if (moved > 6) return;
      const card = (document.elementFromPoint(event.clientX, event.clientY) as Element | null)?.closest<HTMLElement>("[data-card]");
      if (!card) return;
      const index = deck.indexOf(card);
      if (index < 0) return;
      if (index === active) {
        const href = card.dataset.href;
        if (href) goFrom(card, href);
      } else {
        goTo(index);
      }
    };

    stage.addEventListener("pointerup", release);
    stage.addEventListener("pointercancel", release);

    window.addEventListener("keydown", (event) => {
      if (!locked || (event.target as HTMLElement | null)?.closest("input, textarea, button, a")) return;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") {
        event.preventDefault();
        goTo(active + 1);
      } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
        event.preventDefault();
        goTo(active - 1);
      } else if (event.key === "Enter" && deck[active]?.dataset.href) {
        goFrom(deck[active], deck[active].dataset.href ?? "");
      }
    });

    filters.forEach((filter) => filter.addEventListener("click", () => setFilter(filter.dataset.filter ?? "all")));
    window.addEventListener("resize", measure);

    measure();
    requestAnimationFrame(frame);
  }
</script>
