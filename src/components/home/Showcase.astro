---
import type { Lang } from "../../data/i18n";
import { getImage } from "astro:assets";
import { getProjects } from "../../data/projects";
import { localePath, useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const copy = ui.showcase;
const pad = (value: number) => String(value).padStart(2, "0");

const projects = (await getProjects()).filter((project) => project.home);
const items = await Promise.all(
  projects.map(async (project) => {
    const image = await getImage({ src: project.cover, width: 900, format: "webp", quality: 80 });
    return {
      name: project.name,
      kind: ui.projectsPage[project.category],
      image: { src: image.src, width: Number(image.attributes.width), height: Number(image.attributes.height) },
      href: localePath(lang, `/projects/${project.slug}`)
    };
  })
);

const start = Math.min(2, items.length - 1);
const views = ["showcase", "list", "slider"];
---

<section class="show" data-show data-mode="showcase" data-start={start}>
  <h1 class="show__hidden">{ui.handle} — {ui.aboutPage.role.join(" ")}</h1>

  <div class="show__top">
    <p class="show__small"><span data-current>{pad(start + 1)}</span> / {pad(items.length)} {copy.works}</p>
    <div class="show__views" role="group" aria-label={copy.label}>
      {
        views.map((view, index) => (
          <button class:list={["show__small", "show__view", index === 0 && "is-active"]} type="button" data-view={view} aria-pressed={index === 0 ? "true" : "false"}>
            [ {copy.views[index]} ]
          </button>
        ))
      }
    </div>
    <span></span>
  </div>

  <div class="show__stage" data-stage>
    <div class="show__ring" data-ring>
      {
        items.map((item, index) => (
          <figure class="show__card" data-card data-magnet data-label={item.href ? `[ ${copy.go} ↗ ]` : undefined} data-href={item.href} data-kind={item.kind} data-name={item.name} data-ratio={(item.image.width / item.image.height).toFixed(4)} style={`--ratio:${(item.image.width / item.image.height).toFixed(4)}`}>
            <img src={item.image.src} width={item.image.width} height={item.image.height} alt={item.name} draggable="false" loading={index < 6 ? "eager" : "lazy"} />
          </figure>
        ))
      }
    </div>

    <p class="show__small show__caption" aria-live="polite">
      <span class="show__grey" data-caption-num>({pad(start + 1)})</span>
      <span data-caption-name>{items[start]?.name}</span>
    </p>
  </div>

  <ol class="show__names">
    {
      items.map((item, index) => (
        <li>
          <button class:list={["show__small", "show__name", index === start && "is-active"]} type="button" data-pick={index}>
            {item.name}
          </button>
        </li>
      ))
    }
  </ol>

  <p class="show__small show__code" aria-hidden="true">
    <span data-code>({pad(start + 1)})</span>
    <span class="show__grey" data-kind>{items[start]?.kind}</span>
  </p>

  <div class="show__foot">
    <a class="show__small show__talk" href={localePath(lang, "/contact")}>[ {copy.talk} ↗ ]</a>
    <button class="show__small show__unlock" type="button" data-unlock>[ {ui.footer.unlock} ↓ ]</button>
    <p class="show__small show__grey">© SIDUS — 2026</p>
  </div>
</section>

<style>
  .show {
    --case: 270px;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100svh;
    padding: 11svh var(--gutter) 4svh;
    overflow: hidden;
    color: var(--color-black);
    background: var(--color-white);
    user-select: none;
  }

  .show__hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .show__small {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    font-weight: var(--font-weight-regular);
  }

  .show__grey {
    color: var(--color-grey);
  }

  .show__top {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 2vw;
  }

  .show__views {
    display: flex;
    gap: 1.2vw;
  }

  .show__view,
  .show__name {
    white-space: nowrap;
    cursor: pointer;
    color: var(--color-grey);
    transition: color 0.3s ease;
  }

  .show__view:hover,
  .show__view.is-active,
  .show__name:hover,
  .show__name.is-active {
    color: var(--color-black);
  }

  .show__unlock {
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .show__unlock:hover {
    opacity: 0.5;
  }

  :global(html.is-locked),
  :global(html.is-locked body) {
    overflow: hidden;
  }

  .show__about {
    display: flex;
    flex-direction: column;
    justify-self: end;
    text-align: right;
    color: var(--color-grey);
  }

  .show__stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    perspective: 1600px;
    perspective-origin: 50% 50%;
    cursor: grab;
    touch-action: none;
  }

  .show__stage.is-dragging {
    cursor: grabbing;
  }

  .show__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  .show__card {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--case) * var(--ratio, 1));
    height: var(--case);
    margin: 0;
    overflow: hidden;
    transform-origin: 50% 50%;
    backface-visibility: visible;
    will-change: transform;
  }

  .show.is-switching .show__card {
    transition:
      transform 0.9s cubic-bezier(0.45, 0, 0.15, 1),
      opacity 0.9s ease;
  }

  .show__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .show__caption {
    position: absolute;
    top: calc(50% + var(--case) / 2 + 1.2em);
    left: 50%;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    gap: 1em;
    width: max(var(--case), 16em);
    white-space: nowrap;
    pointer-events: none;
    transform: translateX(-50%);
    transition:
      top 0.9s cubic-bezier(0.45, 0, 0.15, 1),
      opacity 0.4s ease;
  }

  .show[data-mode="slider"] .show__caption {
    top: calc(50% - var(--case) / 2 - 2.2em);
    width: var(--active-w, var(--case));
  }

  .show[data-mode="list"] .show__caption {
    opacity: 0;
  }

  .show__names {
    position: absolute;
    top: 50%;
    left: var(--gutter);
    z-index: 10;
    margin: 0;
    padding: 0;
    list-style: none;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition: opacity 0.5s ease;
  }

  .show__code {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 0.5s ease;
  }

  .show[data-mode="list"] .show__names,
  .show[data-mode="list"] .show__code {
    opacity: 1;
    pointer-events: auto;
  }

  .show__name {
    display: block;
    text-align: left;
  }

  .show__foot {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2vw;
    margin-top: auto;
  }

  .show__talk {
    padding: 0.5em 0.8em;
    background: var(--color-black);
    color: var(--color-white);
  }

  @media (max-width: 767px) {
    .show__top {
      grid-template-columns: 1fr;
      gap: 1.2svh;
    }

    .show__about,
    .show__names {
      display: none;
    }


    .show__views {
      gap: 0.8em;
    }

    .show__foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  import { goFrom } from "../../lib/wipe";
  import { getScroll } from "../../lib/scroll";

  const show = document.querySelector<HTMLElement>("[data-show]");
  const stage = show?.querySelector<HTMLElement>("[data-stage]");
  const ring = show?.querySelector<HTMLElement>("[data-ring]");

  if (show && stage && ring) {
    const cards = Array.from(ring.querySelectorAll<HTMLElement>("[data-card]"));
    const views = Array.from(show.querySelectorAll<HTMLButtonElement>("[data-view]"));
    const picks = Array.from(show.querySelectorAll<HTMLButtonElement>("[data-pick]"));
    const current = show.querySelector<HTMLElement>("[data-current]");
    const captionNum = show.querySelector<HTMLElement>("[data-caption-num]");
    const captionName = show.querySelector<HTMLElement>("[data-caption-name]");
    const code = show.querySelector<HTMLElement>("[data-code]");
    const kind = show.querySelector<HTMLElement>("[data-kind]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const count = cards.length;
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const pad = (value: number) => String(value).padStart(2, "0");
    const wrap = (value: number) => value - count * Math.round(value / count);
    const modulo = (value: number) => ((value % count) + count) % count;

    let mode = "showcase";
    let size = 270;
    let radius = 720;
    let step = 275;
    let gap = 5;
    let widths: number[] = [];
    let centers: number[] = [];
    let loop = 1;
    const ratios = cards.map((card) => Number(card.dataset.ratio ?? 1));
    let pos = Number(show.dataset.start ?? 0);
    let target = pos;
    let goal: number | null = null;
    let velocity = 0;
    let speed = 0;
    let previous = pos;
    let tilt = 0;
    let active = -1;
    let snap = 0;
    let switching = 0;
    let dragging = false;
    let moved = 0;
    let startX = 0;
    let startY = 0;
    let startPos = 0;
    let startTilt = 0;
    let lastX = 0;
    let lastMove = 0;

    const measure = () => {
      const width = window.innerWidth;
      const height = window.innerHeight;
      size = width < 768 ? width * 0.52 : 270 * clamp(Math.min(width / 1440, height / 850), 0.6, 1.6);
      radius = size * (720 / 270);
      step = size * (275 / 270);
      gap = size * (5 / 270);
      widths = ratios.map((ratio) => size * ratio);
      centers = [];
      let offset = 0;
      widths.forEach((width) => {
        centers.push(offset + width / 2);
        offset += width + gap;
      });
      loop = offset;
      show.style.setProperty("--case", `${size.toFixed(1)}px`);
    };

    const setMode = (next: string) => {
      if (next === mode && show.dataset.mode === next) return;
      mode = next;
      show.dataset.mode = next;
      goal = null;
      velocity = 0;
      target = Math.round(pos);
      show.classList.add("is-switching");
      window.clearTimeout(switching);
      switching = window.setTimeout(() => show.classList.remove("is-switching"), 900);
      views.forEach((view) => {
        const on = view.dataset.view === next;
        view.classList.toggle("is-active", on);
        view.setAttribute("aria-pressed", on ? "true" : "false");
      });
      try {
        localStorage.setItem("home-view", next);
      } catch {}
    };

    const setActive = (index: number) => {
      if (index === active) return;
      active = index;
      const card = cards[index];
      cards.forEach((item, i) => item.classList.toggle("is-active", i === index));
      picks.forEach((pick, i) => pick.classList.toggle("is-active", i === index));
      if (current) current.textContent = pad(index + 1);
      if (captionNum) captionNum.textContent = `(${pad(index + 1)})`;
      if (captionName) captionName.textContent = card.dataset.name ?? "";
      if (code) code.textContent = `(${pad(index + 1)})`;
      if (kind) kind.textContent = card.dataset.kind ?? "";
      show.style.setProperty("--active-w", `${(widths[index] ?? size).toFixed(1)}px`);
    };

    const frame = () => {
      if (mode === "showcase") {
        if (!dragging) {
          if (goal !== null) {
            pos += (goal - pos) * (reduced ? 1 : 0.12);
            velocity = 0;
            if (Math.abs(goal - pos) < 0.001) {
              pos = goal;
              goal = null;
            }
          } else {
            pos += velocity;
            velocity *= 0.93;
            if (Math.abs(velocity) < 0.02) {
              pos += (Math.round(pos) - pos) * 0.05;
              if (Math.abs(velocity) < 0.00003) velocity = 0;
            }
          }
          tilt += (0 - tilt) * 0.08;
        }
        target = pos;
        ring.style.transform = `translateZ(${(-radius).toFixed(1)}px) rotateX(${tilt.toFixed(2)}deg)`;
      } else {
        pos += (target - pos) * (reduced ? 1 : 0.075);
        if (Math.abs(target - pos) < 0.0005) pos = target;
        ring.style.transform = "";
      }

      const delta = pos - previous;
      previous = pos;
      speed += (delta - speed) * 0.25;
      const skew = clamp(speed * 55, -22, 22);
      const shrink = 1 - Math.min(Math.abs(speed) * 1.4, 0.14);

      const base = modulo(pos);
      const floor = Math.floor(base) % count;
      const next = (floor + 1) % count;
      const mix = base - Math.floor(base);
      const focus = centers[floor] * (1 - mix) + (next === 0 ? centers[0] + loop : centers[next]) * mix;
      const wrapLoop = (value: number) => value - loop * Math.round(value / loop);

      cards.forEach((card, index) => {
        const d = wrap(index - pos);
        const image = card.firstElementChild as HTMLElement | null;
        let transform = "";
        let opacity = 1;
        if (mode === "showcase") {
          const angle = d * (360 / count);
          const flip = Math.abs(angle) > 90 ? " scaleX(-1)" : "";
          transform = `translate(-50%, -50%) rotateY(${angle.toFixed(2)}deg) translateZ(${radius.toFixed(1)}px) scale(${shrink.toFixed(3)}) skewX(${skew.toFixed(2)}deg)${flip}`;
          if (image) image.style.transform = "";
        } else if (mode === "slider") {
          const x = wrapLoop(centers[index] - focus);
          transform = `translate(-50%, -50%) translateX(${x.toFixed(1)}px)`;
          if (image) image.style.transform = `translateX(${clamp(-x * 0.08, -10, 10).toFixed(1)}px) scale(1.08)`;
        } else {
          const y = d * (size + gap * 4);
          transform = `translate(-50%, -50%) translateY(${y.toFixed(1)}px)`;
          opacity = clamp(1 - Math.max(0, Math.abs(d) - 2.4) * 0.55, 0.12, 1);
          if (image) image.style.transform = "";
        }
        card.style.transform = transform;
        card.style.opacity = opacity.toFixed(3);
        card.style.zIndex = mode === "showcase" ? "" : String(1000 - Math.round(Math.abs(d) * 10));
      });

      setActive(modulo(Math.round(pos)));
      requestAnimationFrame(frame);
    };

    const nearest = (index: number) => pos + wrap(index - pos);

    const goTo = (index: number) => {
      window.clearTimeout(snap);
      if (mode === "showcase") goal = Math.round(nearest(index));
      else target = Math.round(nearest(index));
    };

    const html = document.documentElement;
    const unlock = show.querySelector<HTMLButtonElement>("[data-unlock]");
    let locked = true;
    let away = false;

    const lock = () => {
      locked = true;
      away = false;
      html.classList.add("is-locked");
      getScroll()?.stop();
    };

    const openFooter = () => {
      locked = false;
      html.classList.remove("is-locked");
      const lenis = getScroll();
      lenis?.start();
      const footer = document.querySelector<HTMLElement>("footer");
      if (!footer) return;
      if (lenis) lenis.scrollTo(footer, { duration: 1.4 });
      else footer.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
    };

    unlock?.addEventListener("click", openFooter);
    window.addEventListener("scroll", () => {
      if (locked) return;
      if (window.scrollY > 80) away = true;
      if (away && window.scrollY < 4) lock();
    });
    lock();
    window.setTimeout(() => {
      if (locked) getScroll()?.stop();
    }, 0);

    show.addEventListener(
      "wheel",
      (event) => {
        if (!locked) return;
        event.preventDefault();
        event.stopPropagation();
        const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        if (mode === "showcase") {
          goal = null;
          velocity += delta * 0.00028;
          return;
        }
        target += delta * 0.0016;
        window.clearTimeout(snap);
        snap = window.setTimeout(() => {
          target = Math.round(target);
        }, 140);
      },
      { passive: false }
    );

    stage.addEventListener("pointerdown", (event) => {
      if (!locked) return;
      dragging = true;
      moved = 0;
      goal = null;
      velocity = 0;
      startX = lastX = event.clientX;
      startY = event.clientY;
      startPos = mode === "showcase" ? pos : target;
      startTilt = tilt;
      lastMove = 0;
      stage.classList.add("is-dragging");
      stage.setPointerCapture(event.pointerId);
    });

    stage.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      moved = Math.max(moved, Math.abs(dx), Math.abs(dy));
      lastMove = event.clientX - lastX;
      lastX = event.clientX;
      if (mode === "showcase") {
        pos = startPos - dx / (step * 1.6);
        tilt = clamp(startTilt - dy * 0.03, -14, 14);
      } else if (mode === "slider") {
        target = startPos - dx / step;
      } else {
        target = startPos - dy / step;
      }
    });

    const release = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      stage.classList.remove("is-dragging");
      if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
      if (mode === "showcase") velocity = -lastMove / (step * 1.6);
      else target = Math.round(target);
      if (moved > 6) return;
      const card = (document.elementFromPoint(event.clientX, event.clientY) as Element | null)?.closest<HTMLElement>("[data-card]");
      if (!card) return;
      const index = cards.indexOf(card);
      if (index === active) {
        const href = card.dataset.href;
        if (href) goFrom(card, href);
      } else {
        goTo(index);
      }
    };

    stage.addEventListener("pointerup", release);
    stage.addEventListener("pointercancel", release);

    window.addEventListener("keydown", (event) => {
      if (!locked || (event.target as HTMLElement | null)?.closest("input, textarea, button, a")) return;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") {
        event.preventDefault();
        goTo(active + 1);
      } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
        event.preventDefault();
        goTo(active - 1);
      } else if (event.key === "Enter" && cards[active]?.dataset.href) {
        goFrom(cards[active], cards[active].dataset.href ?? "");
      }
    });

    picks.forEach((pick) => pick.addEventListener("click", () => goTo(Number(pick.dataset.pick))));
    views.forEach((view) => view.addEventListener("click", () => setMode(view.dataset.view ?? "showcase")));
    window.addEventListener("resize", measure);

    measure();
    try {
      const saved = localStorage.getItem("home-view");
      if (saved && views.some((view) => view.dataset.view === saved)) {
        mode = saved;
        show.dataset.mode = saved;
        views.forEach((view) => {
          const on = view.dataset.view === saved;
          view.classList.toggle("is-active", on);
          view.setAttribute("aria-pressed", on ? "true" : "false");
        });
      }
    } catch {}
    requestAnimationFrame(frame);
  }
</script>
