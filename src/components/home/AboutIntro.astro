---
import type { Lang } from "../../data/i18n";
import me from "../../assets/photos/IMG_9852.jpeg";
import divisionRaw from "../../assets/svg/division.svg?raw";
import { useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const tiles = [0, 1, 2, 3, 4];
const tearPath = divisionRaw.match(/ d="([^"]+)"/)?.[1] ?? "";
const [, tearW, tearH] = divisionRaw.match(/width="([\d.]+)" height="([\d.]+)"/) ?? [];
---

<section class="about" data-about>
  <div class="about__strip" data-strip>
    {tiles.map(() => <canvas class="about__tile" data-tile data-src={me.src}></canvas>)}
  </div>

  <svg class="about__tear" viewBox={`0 0 ${tearW} ${tearH}`} aria-hidden="true">
    <path d={tearPath} fill-rule="evenodd" />
  </svg>

  <div class="about__text">
    {
      ui.about.bioGroups.map((group) => (
        <div class="about__group">
          {group.map((line) => (
            <span class="about__line">
              {line.split("|").map((part, index) => (
                <>
                  {index > 0 && <span class="about__gap" />}
                  <span>{part}</span>
                </>
              ))}
            </span>
          ))}
        </div>
      ))
    }
  </div>

  <ul class="about__tools">
    {ui.intro.tools.map((tool) => <li>{tool}</li>)}
  </ul>

  <h2 class="about__title">{ui.about.title}</h2>
</section>

<style>
  .about {
    position: relative;
    height: max(100svh, calc(var(--title-size) * var(--about-length) + 4svh));
    overflow: hidden;
    background: var(--color-sky);
    color: var(--color-black);
  }

  .about__strip {
    position: absolute;
    top: 0;
    left: 45.9%;
    width: 29.1%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5.36vw;
    will-change: transform;
  }

  .about__tile {
    display: block;
    flex: none;
    width: 100%;
    aspect-ratio: 524 / 712;
    image-rendering: pixelated;
    background: var(--color-black);
  }

  .about__tear {
    position: absolute;
    top: -24vw;
    left: 0;
    z-index: 1;
    width: 100%;
    height: auto;
    fill: var(--color-white);
    pointer-events: none;
  }

  .about__text {
    position: absolute;
    top: 4svh;
    left: 3%;
    z-index: 2;
    width: 41%;
    display: flex;
    flex-direction: column;
    gap: 0.9em;
    font-size: var(--text-large);
    line-height: var(--text-large--line-height);
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    pointer-events: none;
  }

  .about__group {
    margin: 0;
  }

  .about__line::after {
    content: " ";
  }

  .about__gap {
    display: inline-block;
    width: 0.9em;
  }

  .about__tools {
    position: absolute;
    top: 96svh;
    left: 3%;
    transform: translateY(-100%);
    z-index: 2;
    font-size: var(--text-small);
    line-height: 1;
    font-weight: var(--font-weight-regular);
  }

  .about__title {
    position: absolute;
    top: max(2svh, calc((100svh - var(--title-size) * var(--about-length)) / 2));
    right: 3%;
    z-index: 2;
    font-size: var(--title-size);
    line-height: 0.8;
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>("[data-about]");
  const strip = root?.querySelector<HTMLElement>("[data-strip]");
  const tiles = root ? Array.from(root.querySelectorAll<HTMLCanvasElement>("[data-tile]")) : [];
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && strip && tiles.length) {
    const image = new Image();
    image.decoding = "async";

    image.onload = () => {
      let level = -1;
      let from = 0;
      let pitch = 0;

      const place = (progress: number) => {
        const wrapped = gsap.utils.wrap(0, pitch, progress * 3 * pitch);
        gsap.set(strip, { y: from - wrapped });
      };

      const measure = () => {
        const first = tiles[0];
        pitch = tiles[1].offsetTop - first.offsetTop;
        from = -(first.offsetHeight - window.innerHeight * 0.173);
        place(0);
      };

      const paint = (block: number) => {
        const quantized = Math.round(block * 2) / 2;
        if (quantized === level) return;
        level = quantized;
        const width = Math.max(6, Math.round(image.naturalWidth / quantized));
        const height = Math.max(8, Math.round(image.naturalHeight / quantized));
        tiles.forEach((tile) => {
          const context = tile.getContext("2d");
          if (!context) return;
          tile.width = width;
          tile.height = height;
          context.imageSmoothingEnabled = true;
          context.drawImage(image, 0, 0, width, height);
        });
      };

      measure();
      paint(1);

      if (reduced) return;

      ScrollTrigger.create({
        trigger: root,
        start: "top top",
        end: "+=260%",
        pin: true,
        scrub: true,
        onUpdate: (self) => {
          place(self.progress);
          paint(1 + Math.pow(self.progress, 2.2) * 40);
        }
      });

      window.addEventListener("resize", () => {
        measure();
        ScrollTrigger.refresh();
      });
    };

    image.src = tiles[0].dataset.src ?? "";
  }
</script>
