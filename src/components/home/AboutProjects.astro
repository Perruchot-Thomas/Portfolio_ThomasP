---
import type { Lang } from "../../data/i18n";
import meA from "../../assets/photos/IMG_9852.jpeg";
import meB from "../../assets/photos/IMG_9852 2.jpeg";
import meC from "../../assets/photos/imagemoi copie.avif";
import laptop from "../../assets/photos/MacBook_Pro.png";
import divisionRaw from "../../assets/svg/division.svg?raw";
import { localePath, useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const portraits = [meA, meB, meC];
const slots = Array.from({ length: 9 }, (_, index) => portraits[index % portraits.length].src);
const word = ui.nav.projects.toUpperCase();
const hole = word.indexOf("O");
const wordBefore = word.slice(0, hole);
const wordAfter = word.slice(hole + 1);
const paragraphs = ui.about.bio.split(/(?<=\.)\s+/);
const aboutHref = localePath(lang, "/about");
const projectsHref = localePath(lang, "/projects");
const projectsPhrase = lang === "fr" ? "mes projets" : "my projects";
const split = (text: string, phrase: string) => {
  const at = text.indexOf(phrase);
  return at < 0 ? [text, "", ""] : [text.slice(0, at), phrase, text.slice(at + phrase.length)];
};
const blurb = split(ui.projects.blurb, projectsPhrase);
const tearPath = divisionRaw.match(/ d="([^"]+)"/)?.[1] ?? "";

const modules = import.meta.glob<{ src: string; width: number; height: number }>("../../assets/projets/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
  import: "default"
});
const images = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => image);

const hasImages = images.length > 0;
const count = hasImages ? Math.min(images.length, 12) : 8;
const items = Array.from({ length: count }, (_, index) => {
  const image = images[index];
  const ratio = image ? image.width / image.height : 392 / 553;
  return { index, image, ratio };
});
---

<div class="flow" data-flow>
  <div class="flow__head" data-head>
  <div class="flow__top" data-about>
    <div class="flow__bio">
      {
        paragraphs.map((paragraph) => {
          const [before, name, after] = split(paragraph, "Thomas Perruchot");
          return (
            <p>
              {before}
              {name && <a href={aboutHref}>{name}</a>}
              {after}
            </p>
          );
        })
      }
    </div>

    <ul class="flow__tools">
      {ui.intro.tools.map((tool) => <li>{tool}</li>)}
    </ul>

    <div class="flow__photos">
      <div class="flow__strip" data-strip>
        {slots.map((src) => <canvas class="flow__tile" data-tile data-src={src} aria-hidden="true" />)}
      </div>
    </div>
  </div>
  </div>

  <div class="flow__low" data-low>
    <svg class="flow__tear" viewBox="0 0 2883 1289" preserveAspectRatio="none" aria-hidden="true">
      <path d={tearPath} fill-rule="evenodd" />
    </svg>

    <img class="flow__laptop" src={laptop.src} width={laptop.width} height={laptop.height} alt="" draggable="false" />

    <h2 class="flow__word" aria-label={word}>
      <span aria-hidden="true">{wordBefore}</span><a class="flow__hole" href={projectsHref} aria-label={ui.nav.projects}>
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path d="M6 94 L94 6 M22 6 H94 V78" />
        </svg>
      </a><span aria-hidden="true">{wordAfter}</span>
    </h2>

    <p class="flow__blurb">
      {blurb[0]}<a href={projectsHref}>{blurb[1]}</a>{blurb[2]}
    </p>

    <div class="flow__zone" data-panel>
      <div class="flow__lens" data-lens aria-hidden="true">
        {
          items.map((item) => (
            <div class:list={["flow__frame", !hasImages && "flow__frame--ph"]} data-frame={item.index} data-ratio={item.ratio}>
              {hasImages ? (
                <img src={item.image.src} width={item.image.width} height={item.image.height} alt="" draggable="false" loading="eager" />
              ) : (
                <span>{String(item.index + 1).padStart(2, "0")}</span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .flow {
    position: relative;
    overflow-x: clip;
    overflow-y: visible;
    padding-bottom: 100svh;
    background: var(--color-white);
    color: var(--color-black);
  }

  .flow__head {
    position: relative;
    z-index: 2;
  }

  .flow__top {
    position: relative;
    height: 69.2vw;
    background: var(--color-white);
  }

  .flow__low {
    position: relative;
    z-index: 1;
    height: 100.7vw;
    margin-top: -100svh;
    pointer-events: none;
  }

  .flow__bio,
  .flow__tools,
  .flow__blurb {
    position: absolute;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-copy);
    line-height: var(--text-copy--line-height);
    font-weight: var(--font-weight-regular);
  }

  .flow__bio {
    top: 9.4vw;
    left: 1.1vw;
    width: 27.2vw;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .flow__bio p {
    margin: 0;
  }

  .flow__tools {
    top: 7.97vw;
    right: 1.64vw;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    text-align: right;
  }

  .flow__bio a,
  .flow__blurb a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 0.03em;
    text-underline-offset: 0.08em;
  }

  .flow__photos {
    position: absolute;
    top: 23.9vw;
    left: 0;
    width: 100%;
    height: 37.42vw;
  }

  .flow__strip {
    position: absolute;
    top: 0;
    left: -16.09vw;
    display: flex;
    gap: 4.84vw;
    will-change: transform;
  }

  .flow__tile {
    display: block;
    flex: none;
    width: 27.58vw;
    height: 37.42vw;
    image-rendering: pixelated;
    background: var(--color-black);
  }

  .flow__tear {
    position: absolute;
    top: 0;
    left: -68.44vw;
    width: 225.2vw;
    height: 100.7vw;
    fill: var(--color-black);
  }

  .flow__laptop {
    position: absolute;
    top: 22.81vw;
    left: -3.52vw;
    width: 72.34vw;
    height: auto;
    user-select: none;
  }

  .flow__word {
    position: absolute;
    z-index: 3;
    top: calc(33.67vw - 0.03em);
    left: calc(16.8vw - 0.0825em);
    margin: 0;
    color: var(--color-white);
    font-size: calc(80.5vw / var(--proj-length));
    line-height: 0.8;
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .flow__hole {
    position: relative;
    display: inline-block;
    width: 0.672em;
    height: 0.744em;
    margin: 0 0.009em;
    vertical-align: 0.016em;
    border-radius: 50%;
    background: var(--color-white);
    box-shadow: inset 0 0 0 0.048em var(--color-black);
    color: var(--color-black);
    pointer-events: auto;
  }

  .flow__hole svg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.35em;
    height: 0.35em;
    transform: translate(-50%, -50%);
    fill: none;
    stroke: currentColor;
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .flow__blurb {
    z-index: 3;
    top: 49.14vw;
    left: 57.89vw;
    width: 36.95vw;
    color: var(--color-white);
  }

  .flow__blurb a {
    pointer-events: auto;
  }

  .flow__zone {
    position: absolute;
    top: 14vw;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: auto;
  }

  .flow__lens {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .flow__frame {
    position: absolute;
    inset: 0;
  }

  .flow__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .flow__frame--ph {
    display: grid;
    place-items: center;
    background: var(--color-white);
  }

  .flow__frame--ph span {
    font-size: 3vw;
    line-height: 1;
    color: var(--color-black);
  }

  :global(.flow__stamp) {
    position: absolute;
    overflow: hidden;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  const about = document.querySelector<HTMLElement>("[data-about]");
  const head = document.querySelector<HTMLElement>("[data-head]");
  const low = document.querySelector<HTMLElement>("[data-low]");
  const strip = about?.querySelector<HTMLElement>("[data-strip]");
  const tiles = about ? Array.from(about.querySelectorAll<HTMLCanvasElement>("[data-tile]")) : [];

  if (about && head && low && strip && tiles.length) {
    const sources = Array.from(new Set(tiles.map((tile) => tile.dataset.src ?? "")));
    const loaded = new Map<string, HTMLImageElement>();

    const load = (src: string) =>
      new Promise<void>((resolve) => {
        const image = new Image();
        image.decoding = "async";
        image.onload = () => {
          loaded.set(src, image);
          resolve();
        };
        image.onerror = () => resolve();
        image.src = src;
      });

    Promise.all(sources.map(load)).then(() => {
      const baseWidth = 524;
      const baseHeight = 712;
      let level = -1;
      let pitch = 0;
      const period = 3;

      const place = (progress: number) => {
        gsap.set(strip, { x: -gsap.utils.wrap(0, pitch * period, progress * period * pitch) });
      };

      const measure = () => {
        pitch = (strip.children[1] as HTMLElement).offsetLeft - (strip.children[0] as HTMLElement).offsetLeft;
        place(0);
      };

      const paint = (block: number) => {
        const quantized = Math.round(block * 2) / 2;
        if (quantized === level) return;
        level = quantized;
        const width = Math.max(6, Math.round(baseWidth / quantized));
        const height = Math.max(8, Math.round(baseHeight / quantized));
        tiles.forEach((tile) => {
          const image = loaded.get(tile.dataset.src ?? "");
          const context = tile.getContext("2d");
          if (!image || !context) return;
          const ratio = baseWidth / baseHeight;
          const sourceRatio = image.naturalWidth / image.naturalHeight;
          const cropWidth = sourceRatio > ratio ? image.naturalHeight * ratio : image.naturalWidth;
          const cropHeight = sourceRatio > ratio ? image.naturalHeight : image.naturalWidth / ratio;
          tile.width = width;
          tile.height = height;
          context.imageSmoothingEnabled = true;
          context.drawImage(
            image,
            (image.naturalWidth - cropWidth) / 2,
            (image.naturalHeight - cropHeight) / 2,
            cropWidth,
            cropHeight,
            0,
            0,
            width,
            height
          );
        });
      };

      measure();
      paint(1);

      if (reduced) {
        gsap.set(low, { marginTop: 0 });
        gsap.set(low.parentElement, { paddingBottom: 0 });
        return;
      }

      ScrollTrigger.create({
        trigger: about,
        start: "center center",
        end: "+=260%",
        pin: true,
        scrub: true,
        refreshPriority: 1,
        onUpdate: (self) => {
          place(self.progress);
          paint(1 + Math.pow(self.progress, 2.2) * 40);
        }
      });

      gsap.fromTo(
        low,
        { y: 0 },
        {
          y: () => window.innerHeight,
          ease: "none",
          scrollTrigger: {
            trigger: head,
            start: "bottom bottom",
            end: () => "+=" + window.innerHeight,
            scrub: true,
            invalidateOnRefresh: true
          }
        }
      );

      window.addEventListener("resize", () => {
        measure();
        ScrollTrigger.refresh();
      });
    });
  }

  const panel = document.querySelector<HTMLElement>("[data-panel]");
  const lens = panel?.querySelector<HTMLElement>("[data-lens]");
  const frames = lens ? Array.from(lens.querySelectorAll<HTMLElement>("[data-frame]")) : [];

  if (panel && lens && frames.length) {
    const ratios = frames.map((frame) => Number(frame.dataset.ratio));
    const unit = () => window.innerWidth * 0.075;
    const dims = (ratio: number) => ({ width: unit() * Math.sqrt(ratio), height: unit() / Math.sqrt(ratio) });
    let current = 0;
    let layer = 1;

    gsap.set(lens, { xPercent: -50, yPercent: -50, scale: 0.6, ...dims(ratios[0]) });
    gsap.set(frames, { clipPath: "inset(100% 0% 0% 0%)" });
    gsap.set(frames[0], { clipPath: "inset(0% 0% 0% 0%)", zIndex: layer });

    const show = (index: number) => {
      const frame = frames[index];
      layer += 1;
      gsap.set(frame, { zIndex: layer, clipPath: "inset(0% 0% 0% 0%)" });
      gsap.set(lens, dims(ratios[index]));
      current = index;
    };

    const next = () => show((current + 1) % frames.length);

    const stamps: HTMLElement[] = [];
    panel.addEventListener("click", (event) => {
      const box = panel.getBoundingClientRect();
      const size = dims(ratios[current]);
      const copy = frames[current].cloneNode(true) as HTMLElement;
      copy.removeAttribute("style");
      copy.removeAttribute("data-frame");
      const holder = document.createElement("div");
      holder.className = "flow__stamp";
      holder.style.cssText = `left:${event.clientX - box.left - size.width / 2}px;top:${event.clientY - box.top - size.height / 2}px;width:${size.width}px;height:${size.height}px`;
      holder.append(copy);
      panel.insertBefore(holder, lens);
      stamps.push(holder);
      if (stamps.length > 80) stamps.shift()?.remove();
    });

    if (!reduced && fine) {
      const moveX = gsap.quickTo(lens, "x", { duration: 0.18, ease: "power3.out" });
      const moveY = gsap.quickTo(lens, "y", { duration: 0.18, ease: "power3.out" });
      const interval = 0.28;
      let inside = false;
      let timer: gsap.core.Tween | undefined;

      const run = () => {
        timer = gsap.delayedCall(interval, () => {
          next();
          run();
        });
      };

      panel.addEventListener("pointermove", (event) => {
        const box = panel.getBoundingClientRect();
        const x = event.clientX - box.left;
        const y = event.clientY - box.top;

        if (!inside) {
          inside = true;
          gsap.set(lens, { x, y });
          document.documentElement.classList.add("cursor-off");
          gsap.to(lens, { opacity: 1, scale: 1, duration: 0.3, ease: "power2.out", overwrite: "auto" });
          run();
        }

        moveX(x);
        moveY(y);
      });

      panel.addEventListener("pointerleave", () => {
        inside = false;
        timer?.kill();
        document.documentElement.classList.remove("cursor-off");
        gsap.to(lens, { opacity: 0, scale: 0.6, duration: 0.3, ease: "power2.in", overwrite: "auto" });
      });
    }
  }
</script>
