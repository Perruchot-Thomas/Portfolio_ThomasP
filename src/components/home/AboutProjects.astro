---
import type { Lang } from "../../data/i18n";
import unionRaw from "../../assets/svg/union.svg?raw";
import { localePath, useUi } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
const copy = ui.projects;
const aboutHref = localePath(lang, "/about");
const projectsHref = localePath(lang, "/projects");
const shapePath = unionRaw.match(/ d="([^"]+)"/)?.[1] ?? "";

const modules = import.meta.glob<{ src: string; width: number; height: number }>("../../assets/projets/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
  import: "default"
});
const linked = ["acab", "desurbanisation", "crane"];
const ring = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, image]) => {
    const name = path.split("/").pop()?.replace(/^\d+-/, "").replace(/\.\w+$/, "") ?? "";
    const ratio = image.width / image.height;
    return { name, image, link: linked.includes(name), style: `width:${Math.sqrt(123 * ratio).toFixed(2)}vw;aspect-ratio:${image.width} / ${image.height}` };
  });
---

<div class="flow" data-flow>
  <svg class="flow__shape" viewBox="0 0 2682.8 1003.22" preserveAspectRatio="none" aria-hidden="true">
    <path d={shapePath} />
  </svg>

  <p class="flow__col flow__col--1"><a href={aboutHref}>{copy.name}</a>{copy.role}</p>
  <p class="flow__col flow__col--2">{copy.focus}</p>
  <ul class="flow__col flow__col--3">
    {copy.tools.map((tool) => <li>{tool}</li>)}
  </ul>
  <p class="flow__col flow__col--4">{copy.open}</p>

  <div class="flow__marks" aria-hidden="true">*(        )</div>

  <p class="flow__empty">
    <span>EMPTY</span>
    <a href={projectsHref}><span>{copy.go}</span><span aria-hidden="true">→</span></a>
  </p>

  <a class="flow__note flow__archives" href={projectsHref}>{copy.archives}</a>
  <p class="flow__note flow__method flow__method--a">{copy.methodA}</p>
  <p class="flow__note flow__method flow__method--b">{copy.methodB}</p>

  <div class="flow__ring" data-ring>
    {
      ring.map((photo) =>
        photo.link ? (
          <a class="flow__photo" data-photo href={projectsHref} style={photo.style} aria-label={photo.name}>
            <img src={photo.image.src} width={photo.image.width} height={photo.image.height} alt="" draggable="false" loading="lazy" />
          </a>
        ) : (
          <div class="flow__photo" data-photo style={photo.style}>
            <img src={photo.image.src} width={photo.image.width} height={photo.image.height} alt="" draggable="false" loading="lazy" />
          </div>
        )
      )
    }
  </div>

  <a class="flow__arrow" href={projectsHref} aria-label={ui.nav.projects}>
    <svg viewBox="0 0 209.028 223.667" aria-hidden="true">
      <path d="M11.0284 15H194.028V213.5M194.028 15L11.0284 213.5" />
    </svg>
  </a>
</div>

<style>
  .flow {
    position: relative;
    height: 134vw;
    overflow-x: clip;
    background: var(--color-white);
    color: var(--color-black);
  }

  .flow__shape {
    position: absolute;
    top: 52.73vw;
    left: 50%;
    width: 209.6vw;
    height: 78.38vw;
    transform: translateX(-50%);
    fill: var(--color-black);
    pointer-events: none;
  }

  .flow__col,
  .flow__note {
    position: absolute;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 18.4vw;
    font-size: var(--text-copy);
    line-height: 1;
    font-weight: var(--font-weight-regular);
  }

  .flow__col {
    top: 5.39vw;
    color: var(--color-black);
  }

  .flow__col--1 {
    left: 0.94vw;
  }

  .flow__col--1 a {
    color: inherit;
    text-decoration: underline;
  }

  .flow__col--2 {
    left: 30vw;
  }

  .flow__col--3 {
    left: 58.98vw;
  }

  .flow__col--4 {
    right: 3.36vw;
    text-align: right;
  }

  .flow__marks {
    position: absolute;
    top: 24.38vw;
    left: 8.52vw;
    font-size: 23.44vw;
    line-height: 0.8;
    font-weight: var(--font-weight-regular);
    white-space: pre;
    pointer-events: none;
  }

  .flow__empty {
    position: absolute;
    top: 34.45vw;
    left: 33.59vw;
    width: 33.28vw;
    margin: 0;
    color: var(--color-black);
    font-size: var(--text-copy);
    line-height: 0.8;
    font-weight: var(--font-weight-regular);
  }

  .flow__empty a {
    position: absolute;
    top: 0;
    left: 11.33vw;
    display: flex;
    justify-content: space-between;
    width: 21.95vw;
    color: inherit;
  }

  .flow__note {
    position: absolute;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 18.4vw;
    font-size: var(--text-copy);
    line-height: 1;
    font-weight: var(--font-weight-regular);
  }

  .flow__col {
    top: 5.39vw;
    color: var(--color-black);
  }

  .flow__col--1 {
    left: 0.94vw;
  }

  .flow__col--1 a {
    color: inherit;
    text-decoration: underline;
  }

  .flow__col--2 {
    left: 30vw;
  }

  .flow__col--3 {
    left: 58.98vw;
  }

  .flow__col--4 {
    right: 3.36vw;
    text-align: right;
  }

  .flow__marks {
    position: absolute;
    top: 24.38vw;
    left: 8.52vw;
    font-size: 23.44vw;
    line-height: 0.8;
    font-weight: var(--font-weight-regular);
    white-space: pre;
    pointer-events: none;
  }

  .flow__go {
    position: absolute;
    top: 34.45vw;
    left: 44.92vw;
    display: flex;
    justify-content: space-between;
    width: 21.95vw;
    color: var(--color-black);
    font-size: var(--text-copy);
    line-height: 0.8;
    font-weight: var(--font-weight-regular);
  }

  .flow__note {
    z-index: 4;
    left: 1.33vw;
    color: var(--color-white);
  }

  .flow__archives {
    top: 74.14vw;
    width: auto;
  }

  .flow__method--a {
    top: 80.31vw;
    width: 14.5vw;
  }

  .flow__method--b {
    top: 104.69vw;
  }

  .flow__ring {
    position: absolute;
    top: 92.5vw;
    left: 59.26vw;
    width: 0;
    height: 0;
  }

  .flow__photo {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    will-change: transform;
  }

  .flow__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .flow__photo.is-hover img {
    transform: scale(1.5);
  }

  .flow__arrow {
    position: absolute;
    top: 83.75vw;
    left: 51.09vw;
    z-index: 110;
    display: block;
    width: 16.33vw;
    height: 17.47vw;
  }

  .flow__arrow svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--color-white);
    stroke-width: 30;
    stroke-linecap: butt;
    stroke-linejoin: miter;
  }
</style>

<script>
  import { gsap } from "gsap";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ring = document.querySelector<HTMLElement>("[data-ring]");
  const photos = ring ? Array.from(ring.querySelectorAll<HTMLElement>("[data-photo]")) : [];

  if (ring && photos.length) {
    const step = (Math.PI * 2) / photos.length;
    const speed = (Math.PI * 2) / 26;
    let hovered: HTMLElement | null = null;
    let rotation = 0;
    let flow = 1;

    photos.forEach((photo) => {
      photo.addEventListener("pointerenter", () => {
        hovered = photo;
        photo.classList.add("is-hover");
      });
      photo.addEventListener("pointerleave", () => {
        hovered = null;
        photo.classList.remove("is-hover");
      });
    });

    const place = () => {
      const radiusX = window.innerWidth * 0.34;
      const radiusY = window.innerWidth * 0.045;

      photos.forEach((photo, index) => {
        const angle = rotation + index * step;
        const depth = Math.cos(angle);
        const near = (depth + 1) / 2;
        const scale = 0.62 + near * 0.62;
        const x = Math.sin(angle) * radiusX - photo.offsetWidth / 2;
        const y = depth * radiusY - photo.offsetHeight / 2;
        photo.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) scale(${scale.toFixed(3)})`;
        photo.style.zIndex = String(10 + Math.round((photo === hovered ? 2 : near) * 100));
      });
    };

    place();

    if (!reduced) {
      gsap.ticker.add((_time, delta) => {
        flow += ((hovered ? 0 : 1) - flow) * 0.12;
        rotation += (delta / 1000) * speed * flow;
        place();
      });
    }
  }
</script>
